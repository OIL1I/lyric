<idea-plugin>
    <id>dev.lyric.jetbrains</id>
    <name>Lyric</name>
    <vendor>OIL1I</vendor>

    <description><![CDATA[
        Language support for <a href="https://github.com/OIL1I/lyric">Lyric</a> through its own
        language server: project-wide diagnostics, completion, go to definition, find references,
        rename, semantic highlighting, signature help, folding and inlay hints — every answer
        comes from the Lyric compiler, none from a re-implementation.
        <br/><br/>
        The <code>lyrls</code> binary is found on PATH, or under the toolchain directory named in
        <i>Settings&nbsp;|&nbsp;Languages&nbsp;&amp;&nbsp;Frameworks&nbsp;|&nbsp;Lyric</i>.
    ]]></description>

    <!-- The LSP module exists in the commercial IDEs only; naming it, rather than
         com.intellij.modules.ultimate, keeps the plugin loadable in every IDE that has the
         integration — CLion and Rider included. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="dev.lyric.jetbrains.LyricLspServerSupportProvider"/>

        <applicationService serviceImplementation="dev.lyric.jetbrains.LyricSettings"/>

        <applicationConfigurable
            parentId="language"
            instance="dev.lyric.jetbrains.LyricConfigurable"
            id="dev.lyric.jetbrains.settings"
            displayName="Lyric"/>

        <!-- The point is declared by the TextMate plugin but QUALIFIED under com.intellij:
             `com.intellij.textmate.bundleProvider`, verbatim from intellij.textmate.xml. The
             1.2.0 zip registered it under the plugin's own namespace, which exists nowhere —
             the provider was never called and nothing was colored. -->
        <textmate.bundleProvider
            implementation="dev.lyric.jetbrains.LyricTextMateBundleProvider"/>
    </extensions>
</idea-plugin>
