// std.io.console — console output.
//
// The functions have no body: they are backed by natives and bound by their symbolic name when
// the bytecode is loaded. A bodyless function is ordinary syntax; whether it becomes an import or
// an error follows from the module's origin, not its content.
//
// No capability is required: console output is always available.

module std.io.console;

import std.core { Display };
import std.iter { Iterator };

// The native writers take `string`, which is the boundary to the host.
//
// The import list in `import std.io.console { println }` controls name visibility only; it has no
// effect on the generated bytecode. What does:
//
//   * a NATIVE declaration enters the import table only when it is called;
//   * a LYRIC BODY is always emitted once its module is loaded.
//
// A hello-world therefore carries `RangeIterator.next` and `StringIterator.next` with it. That is
// a missing reachability analysis in the lowering, and it can be added without a format change.
pub fn print(value: string);
pub fn println(value: string);
pub fn eprintln(value: string);

// `write(42)`, `write(true)`, `write("hi")`. There is no overloading; a constraint does the same
// job and extends to every type that satisfies `Display` rather than to a fixed list.
//
// Monomorphization turns this into a direct call per used type, so the generality costs nothing at
// runtime.
pub fn write<T :: [Display]>(value: T): void {
    print(value.show());
}

pub fn writeln<T :: [Display]>(value: T): void {
    println(value.show());
}

// ------------------------------------------------------------------------------ input
//
// `?string`, because EOF is a state rather than an error: the input has ended.
pub fn readLine(): ?string;

// Everything up to EOF, for filters that need the whole text.
pub fn readAll(): string;

// A single code point.
pub fn readChar(): ?char;

// Terminal or pipe: a program writing into a pipe should not put a prompt into the stream.
pub fn isInteractive(): bool;

// Needed as soon as a prompt is written without a line break.
pub fn flush(): void;

pub fn eprint(value: string);

// From here on: written in Lyric, not native.
//
// Both could be written in the host and would be shorter there. Every native is a signature the
// bytecode contract has to carry, so what the language can express stays on this side.

// Writes the question, flushes, reads the answer. Without the flush the question would sit in
// the buffer while the program waits.
pub fn prompt(text: string): ?string {
    print(text);
    flush();
    return readLine();
}

// The idiomatic shape of a filter:
//
//     for (line in console.lines()) { ... }
//
// An iterator rather than a `string[]`: the input can be larger than memory, and a program that
// only counts should not have to collect it first.
pub class LineIterator :: [Iterator<string>] {
    done: bool = false,

    pub mut fn next(): ?string {
        if (this.done) {
            return null;
        }
        let line = readLine();
        if (line == null) {
            this.done = true;
        }
        return line;
    }
}

pub fn lines(): Iterator<string> {
    return LineIterator { };
}
