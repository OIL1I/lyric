// std.io.file — reading and writing files.
//
// Capability-gated: an import requires `fileAccess`. A script embedded in a host must not reach
// the disk, while the same language standalone may be a CLI tool.
//
// Failures are return values, not exceptions. A file that does not exist is an ordinary state of
// the world, so `readText` returns `?string` rather than `string` with `throws`. A panic stays
// reserved for what the programmer got wrong.

module std.io.file;

// For the path helpers below. 'std.string' imports nothing, so there is no cycle.
import std.string { length, charAt, substring };

// The whole content as text (UTF-8), or `null` when the file does not exist or is not
// readable.
pub fn readText(path: string): ?string;

// Writes text (UTF-8), replacing an existing file. `true` on success.
pub fn writeText(path: string, content: string): bool;

// Appends to an existing file or creates it. `true` on success.
pub fn appendText(path: string, content: string): bool;

pub fn exists(path: string): bool;

// `true` when the file is gone afterwards, including when it never existed.
pub fn remove(path: string): bool;

// The lines of a file, or an empty array when it is not readable. Terminators are removed, so
// whether the file used CRLF or LF is no longer visible.
pub fn readLines(path: string): string[];

// ------------------------------------------------------------------------------------------
//
// Every return is a `?T` or a `bool`: a missing file, an unreadable directory, a full disk are
// states of the world rather than programming errors.
//
// The capability hangs off the module name, so no individual function has to state it.

pub fn size(path: string): ?int;
pub fn isFile(path: string): bool;
pub fn isDirectory(path: string): bool;

/// Copies. `false` when the source is missing or the target is not writable.
pub fn copy(from: string, to: string): bool;

/// Moves or renames; the same operation on every file system.
pub fn move(from: string, to: string): bool;

pub fn createDir(path: string): bool;

/// Creates missing parent directories too. An existing directory counts as success.
pub fn createDirAll(path: string): bool;

/// Deletes an EMPTY directory. There is no recursive delete; a caller that needs one writes
/// the loop visibly.
pub fn removeDir(path: string): bool;

/// The entries of a directory: names rather than paths, sorted alphabetically.
///
/// An empty array for an unreadable directory rather than a `?string[]`, as in `readLines`. A
/// caller that needs the difference asks `isDirectory` first.
pub fn listDir(path: string): string[];

/// A path in the system's temporary directory. Does NOT create the file.
pub fn tempDir(): string;

// ------------------------------------------------------------------------ paths, in Lyric
//
// Nothing below is native: a path is a string, and finding separators is something the language
// does. A host would bring its own platform convention into a platform-neutral bytecode.

/// Beide Trennzeichen gelten. Windows versteht `/`, und ein Skript, das auf beiden Systemen
/// laufen soll, sollte nicht raten muessen, welches es gerade ist.
fn istTrenner(c: char): bool {
    return c == '/' || c == '\\';
}

/// Fuegt zwei Pfadteile zusammen — ohne doppeltes Trennzeichen und ohne fehlendes.
pub fn joinPath(links: string, rechts: string): string {
    if (length(links) == 0) {
        return rechts;
    }
    if (length(rechts) == 0) {
        return links;
    }

    let endetMitTrenner = istTrenner(charAt(links, length(links) - 1));
    let beginntMitTrenner = istTrenner(charAt(rechts, 0));

    if (endetMitTrenner && beginntMitTrenner) {
        return links + substring(rechts, 1, length(rechts) - 1);
    }
    if (endetMitTrenner || beginntMitTrenner) {
        return links + rechts;
    }
    return links + "/" + rechts;
}

// Der Index nach dem letzten Trennzeichen — 0, wenn es keines gibt.
fn nachLetztemTrenner(path: string): int {
    var i = length(path) - 1;
    while (i >= 0) {
        if (istTrenner(charAt(path, i))) {
            return i + 1;
        }
        i = i - 1;
    }
    return 0;
}

/// Der letzte Bestandteil. `"a/b/c.txt"` wird `"c.txt"`.
pub fn fileName(path: string): string {
    let start = nachLetztemTrenner(path);
    return substring(path, start, length(path) - start);
}

/// Alles vor dem letzten Trennzeichen. `""`, wenn es keines gibt.
pub fn parentDir(path: string): string {
    let start = nachLetztemTrenner(path);
    if (start == 0) {
        return "";
    }
    // Das Trennzeichen selbst faellt weg — ausser bei "/x", wo der Elternpfad die Wurzel ist.
    if (start == 1) {
        return substring(path, 0, 1);
    }
    return substring(path, 0, start - 1);
}

/// Die Endung OHNE Punkt. `""`, wenn es keine gibt.
///
/// Ein fuehrender Punkt zaehlt nicht: `".gitignore"` hat keine Endung, sondern heisst so. Diese
/// Regel unterscheidet sich zwischen Sprachen, und sie hier hinzuschreiben ist billiger, als sie
/// jemanden herausfinden zu lassen.
pub fn extension(path: string): string {
    let name = fileName(path);
    var i = length(name) - 1;
    while (i > 0) {
        if (charAt(name, i) == '.') {
            return substring(name, i + 1, length(name) - i - 1);
        }
        if (istTrenner(charAt(name, i))) {
            return "";
        }
        i = i - 1;
    }
    return "";
}

/// Der Name ohne Endung. `"a/b/c.txt"` wird `"c"`.
pub fn stem(path: string): string {
    let name = fileName(path);
    let ext = extension(name);
    if (length(ext) == 0) {
        return name;
    }
    return substring(name, 0, length(name) - length(ext) - 1);
}

/// Tauscht die Endung. Eine leere Endung entfernt sie.
pub fn withExtension(path: string, ext: string): string {
    let ordner = parentDir(path);
    let basis = stem(path);
    let neu = if (length(ext) == 0) basis else basis + "." + ext;
    return if (length(ordner) == 0) neu else joinPath(ordner, neu);
}

/// Beginnt der Pfad an der Wurzel? Erkennt `/x` und `C:\x`.
pub fn isAbsolute(path: string): bool {
    if (length(path) == 0) {
        return false;
    }
    if (istTrenner(charAt(path, 0))) {
        return true;
    }
    // Laufwerksbuchstabe: 'C:' am Anfang.
    return length(path) >= 2 && charAt(path, 1) == ':';
}
