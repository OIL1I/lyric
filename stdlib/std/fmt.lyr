// std.fmt — format specifiers for f-strings.
//
// `f"{avg:N2}"` becomes `formatFloat(avg, "N2")`. Without a specifier the `fromXxx` converters of
// `std.string` apply.
//
// The specifier language is .NET's: `N2` (thousands separators, two decimals), `F3` (fixed), `D5`
// (zero-padded), `X` (hex), `E2` (scientific), `P1` (percent). It is passed to the runtime
// unchanged; there is no second notation beside it.
//
// Always invariant, never culture-dependent: the same program produces the same output on every
// machine. Localizing is an explicit choice, not something the environment decides.
//
// The names distinguish by source type (`formatInt`, `formatFloat`, …) rather than being
// overloads, as in `std.string.fromXxx`.

module std.fmt;

// An invalid specifier is a panic rather than an error value: it is a literal in the source and
// does not depend on the input.
pub fn formatInt(value: int, spec: string): string;
pub fn formatUint(value: uint, spec: string): string;
pub fn formatFloat(value: float, spec: string): string;
pub fn formatBool(value: bool, spec: string): string;
pub fn formatChar(value: char, spec: string): string;

// .NET has no standard formats for strings, so here the specifier is a width: padding on the
// right (`{name:10}`) or, with a leading minus, on the left (`{name:-10}`).
pub fn formatString(value: string, spec: string): string;

// ================================================================== written in Lyric
//
// Number bases and alignment. Neither needs a native edge: a base conversion is division with
// remainder, and alignment is padding.

import std.string { length, repeat, fromChar, padStart, padEnd, digitToChar };

// ------------------------------------------------------------------------ number bases

/// To a base from 2 to 36. Letters from `a` for digit values above 9.
///
/// The inverse of `std.string.parseIntRadix`. They live in different modules because parsing is
/// text processing and formatting is output, and `std.string` must not import `std.fmt`.
pub fn formatRadix(value: int, radix: int): string {
    if (radix < 2 || radix > 36) {
        return "";
    }
    if (value == 0) {
        return "0";
    }

    // The magnitude is taken first and the sign appended at the end: `%` follows the sign of
    // the dividend, so a negative number would produce negative digits.
    let negativ = value < 0;
    var rest = if (negativ) 0 - value else value;

    var ziffern = "";
    while (rest > 0) {
        let stelle = rest % radix;
        ziffern = ziffernZeichen(stelle) + ziffern;
        rest = rest / radix;
    }

    return if (negativ) "-" + ziffern else ziffern;
}

// 0..9 becomes '0'..'9', from 10 on 'a'..'z'.
fn ziffernZeichen(value: int): string {
    if (value < 10) {
        let c = digitToChar(value);
        // The short form works because the `if` expression narrows `c` in the else branch.
        // `char`. Vorher stand hier ein Umweg ueber zwei Statements.
        return if (c == null) "?" else fromChar(c);
    }
    return fromChar((('a' as int) + value - 10) as char);
}

pub fn formatHex(value: int): string {
    return formatRadix(value, 16);
}

pub fn formatBinary(value: int): string {
    return formatRadix(value, 2);
}

pub fn formatOctal(value: int): string {
    return formatRadix(value, 8);
}

/// Hexadecimal with a fixed number of digits and leading zeros: `formatHexPadded(255, 4)` is
/// `"00ff"`, for addresses and colour values where the width carries meaning.
pub fn formatHexPadded(value: int, width: int): string {
    return padStart(formatHex(value), width, '0');
}

// ------------------------------------------------------------------ Ausrichtung

pub fn padLeft(value: string, width: int): string {
    return padStart(value, width, ' ');
}

pub fn padRight(value: string, width: int): string {
    return padEnd(value, width, ' ');
}

/// Centres. On an odd remainder the extra character goes to the RIGHT.
/// Festlegung, keine Selbstverstaendlichkeit, aber ohne sie liefert dieselbe Eingabe je nach
/// Implementierung zwei verschiedene Ergebnisse.
pub fn center(value: string, width: int): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    let links = fehlend / 2;
    return repeat(" ", links) + value + repeat(" ", fehlend - links);
}

// ------------------------------------------------------------------ Groessen

/// Bytes in readable form: `1536` becomes `"1.5 KB"`.
///
/// Base 1024 with the prefixes without `i` (`KB` rather than `KiB`), the spelling operating
/// systems and tools actually use.
pub fn formatBytes(bytes: int): string {
    if (bytes < 1024) {
        return formatInt(bytes, "") + " B";
    }

    let einheiten = ["KB", "MB", "GB", "TB", "PB"];
    var wert = bytes as float;
    var stufe = -1;

    // Divide while a larger unit exists and the value fills it.
    while (wert >= 1024.0 && stufe + 1 < einheiten.length) {
        wert = wert / 1024.0;
        stufe = stufe + 1;
    }

    return formatFloat(wert, "N1") + " " + einheiten[stufe];
}

// ------------------------------------------------------------------ Tabellen

/// Aligns columns. Each row is a `string[]`; short rows are padded with empty cells.
///
/// No borders and no header handling: what a table means is the caller's business. This does the
/// tedious part — two passes over the data, to know the column widths before printing.
pub fn table(rows: (string[])[], separator: string): string {
    if (rows.length == 0) {
        return "";
    }

    // First pass: the widest cell per column.
    var spalten = 0;
    var i = 0;
    while (i < rows.length) {
        if (rows[i].length > spalten) {
            spalten = rows[i].length;
        }
        i = i + 1;
    }

    var breiten = [0] * spalten;
    i = 0;
    while (i < rows.length) {
        var j = 0;
        while (j < rows[i].length) {
            let l = length(rows[i][j]);
            if (l > breiten[j]) {
                breiten[j] = l;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Second pass: pad and join.
    var result = "";
    i = 0;
    while (i < rows.length) {
        if (i > 0) {
            result = result + "\n";
        }
        var j = 0;
        while (j < spalten) {
            if (j > 0) {
                result = result + separator;
            }
            let zelle = if (j < rows[i].length) rows[i][j] else "";
            // The last column is NOT padded, or invisible trailing spaces would remain.
            result = result + (if (j == spalten - 1) zelle else padEnd(zelle, breiten[j], ' '));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}
