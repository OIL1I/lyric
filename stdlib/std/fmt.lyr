// std.fmt — Format-Specs für f-Strings (Sprache.md §2.2).
//
// `f"{avg:N2}"` wird zu `formatFloat(avg, "N2")`. Ohne Spec bleibt es bei den `fromXxx`-Wandlern
// aus `std.string`: ein Format-Aufruf, der nur den Standard nachbaut, wäre ein zweiter Weg zu
// demselben Ergebnis.
//
// **Die Spec-Sprache ist die von .NET**, wie §2.2 es verlangt: `N2` (Tausendertrenner, zwei
// Nachkommastellen), `F3` (fest), `D5` (mit Nullen aufgefüllt), `X` (hex), `E2`
// (wissenschaftlich), `P1` (Prozent). Sie wird unverändert an die Runtime durchgereicht — Lyric
// erfindet keine eigene Notation daneben.
//
// **Immer invariant**, nie kulturabhängig. Dasselbe Programm muss auf jeder Maschine dasselbe
// ausgeben; eine Zahl, die unter deutscher Locale `1.234,57` und unter englischer `1,234.57`
// wird, ist kein Formatierungsdetail, sondern ein Programm, das sich je nach Rechner anders
// verhält. Wer bewusst lokalisieren will, tut das später über eine explizite Kultur — nicht
// versehentlich über die Umgebung.
//
// Die Namen unterscheiden nach Quelltyp (`formatInt`, `formatFloat`, …) statt gleichnamige
// Überladungen zu sein — dieselbe Regel wie bei `std.string.fromXxx`, und aus demselben Grund
// (ADR-015: Lyric hat kein Overloading).

module std.fmt;

// Eine ungueltige Spec ist ein panic, kein Fehlerwert: sie steht als Literal im Quelltext und
// haengt nicht von der Eingabe ab. Ein Programm mit `{x:Q9}` ist falsch geschrieben, nicht
// unglücklich gelaufen.
pub fn formatInt(value: int, spec: string): string;
pub fn formatUint(value: uint, spec: string): string;
pub fn formatFloat(value: float, spec: string): string;
pub fn formatBool(value: bool, spec: string): string;
pub fn formatChar(value: char, spec: string): string;

// Fuer Strings kennt .NET keine Standard-Formate; hier ist die Spec eine Breite, die rechts
// auffuellt (`{name:10}`) bzw. mit fuehrendem Minus links (`{name:-10}`). Mehr braucht v1 nicht,
// und mehr zu erfinden hiesse, eine zweite Notation neben die von .NET zu stellen.
pub fn formatString(value: string, spec: string): string;

// ====================================================== In Lyric geschrieben (M8b/S7)
//
// Zahlenbasen und Ausrichtung. Beides braucht keine native Kante: eine Basis-Umwandlung ist
// Division mit Rest, und Ausrichtung ist Auffuellen — die Sprache kann das seit ADR-022, weil
// `char` eine Zahl ist.

import std.string { length, repeat, fromChar, padStart, padEnd, digitToChar };

// ------------------------------------------------------------------ Zahlenbasen

/// Zu einer Basis von 2 bis 36. Buchstaben ab `a` fuer Ziffernwerte ueber 9.
///
/// Die Umkehrung von `std.string.parseIntRadix`. Beide stehen bewusst in verschiedenen Modulen:
/// Parsen ist Text-Verarbeitung, Formatieren ist Ausgabe — und `std.string` darf `std.fmt` nicht
/// importieren, weil die Abhaengigkeit andersherum laeuft.
pub fn formatRadix(value: int, radix: int): string {
    if (radix < 2 || radix > 36) {
        return "";
    }
    if (value == 0) {
        return "0";
    }

    // Der Betrag wird ZUERST genommen und das Vorzeichen am Ende angehaengt: `%` folgt in Lyric
    // dem Vorzeichen des Dividenden (§6.6), eine negative Zahl gaebe also negative Ziffern.
    let negativ = value < 0;
    var rest = if (negativ) 0 - value else value;

    var ziffern = "";
    while (rest > 0) {
        let stelle = rest % radix;
        ziffern = ziffernZeichen(stelle) + ziffern;
        rest = rest / radix;
    }

    return if (negativ) "-" + ziffern else ziffern;
}

// 0..9 wird '0'..'9', ab 10 wird 'a'..'z'.
fn ziffernZeichen(value: int): string {
    if (value < 10) {
        let c = digitToChar(value);
        // Als Statement und nicht als `if`-Ausdruck: Flow-Narrowing greift dort nicht, `c` bliebe
        // im else-Zweig ein `?char`.
        if (c == null) {
            return "?";
        }
        return fromChar(c);
    }
    return fromChar((('a' as int) + value - 10) as char);
}

pub fn formatHex(value: int): string {
    return formatRadix(value, 16);
}

pub fn formatBinary(value: int): string {
    return formatRadix(value, 2);
}

pub fn formatOctal(value: int): string {
    return formatRadix(value, 8);
}

/// Hexadezimal mit fester Stellenzahl und fuehrenden Nullen — `formatHexPadded(255, 4)` ist
/// `"00ff"`. Fuer Adressen und Farbwerte, wo die Breite die Bedeutung traegt.
pub fn formatHexPadded(value: int, width: int): string {
    return padStart(formatHex(value), width, '0');
}

// ------------------------------------------------------------------ Ausrichtung

pub fn padLeft(value: string, width: int): string {
    return padStart(value, width, ' ');
}

pub fn padRight(value: string, width: int): string {
    return padEnd(value, width, ' ');
}

/// Zentriert. Bei ungerader Restbreite geht das zusaetzliche Zeichen nach RECHTS — eine
/// Festlegung, keine Selbstverstaendlichkeit, aber ohne sie liefert dieselbe Eingabe je nach
/// Implementierung zwei verschiedene Ergebnisse.
pub fn center(value: string, width: int): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    let links = fehlend / 2;
    return repeat(" ", links) + value + repeat(" ", fehlend - links);
}

// ------------------------------------------------------------------ Groessen

/// Bytes in lesbarer Form: `1536` wird `"1.5 KB"`.
///
/// Basis 1024 und die Praefixe ohne `i` (`KB` statt `KiB`) — das ist die Schreibweise, die
/// Betriebssysteme und Werkzeuge tatsaechlich benutzen. Wer es normgerecht will, formatiert selbst;
/// wer eine Dateigroesse anzeigt, will das hier.
pub fn formatBytes(bytes: int): string {
    if (bytes < 1024) {
        return formatInt(bytes, "") + " B";
    }

    let einheiten = ["KB", "MB", "GB", "TB", "PB"];
    var wert = bytes as float;
    var stufe = -1;

    // Solange teilen, wie es eine groessere Einheit gibt UND der Wert sie fuellt.
    while (wert >= 1024.0 && stufe + 1 < einheiten.length) {
        wert = wert / 1024.0;
        stufe = stufe + 1;
    }

    return formatFloat(wert, "N1") + " " + einheiten[stufe];
}

// ------------------------------------------------------------------ Tabellen

/// Richtet Spalten aneinander aus. Jede Zeile ist ein `string[]`; kurze Zeilen werden mit leeren
/// Zellen aufgefuellt.
///
/// Ohne Rahmen und ohne Kopfzeilen-Sonderbehandlung: was eine Tabelle bedeutet, weiss der
/// Aufrufer. Diese Funktion macht nur das, was von Hand laestig ist — zweimal ueber die Daten
/// laufen, um die Spaltenbreiten zu kennen, bevor die erste Zeile gedruckt wird.
pub fn table(rows: (string[])[], separator: string): string {
    if (rows.length == 0) {
        return "";
    }

    // Erster Durchgang: die breiteste Zelle je Spalte.
    var spalten = 0;
    var i = 0;
    while (i < rows.length) {
        if (rows[i].length > spalten) {
            spalten = rows[i].length;
        }
        i = i + 1;
    }

    var breiten = [0] * spalten;
    i = 0;
    while (i < rows.length) {
        var j = 0;
        while (j < rows[i].length) {
            let l = length(rows[i][j]);
            if (l > breiten[j]) {
                breiten[j] = l;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Zweiter Durchgang: auffuellen und fuegen.
    var result = "";
    i = 0;
    while (i < rows.length) {
        if (i > 0) {
            result = result + "\n";
        }
        var j = 0;
        while (j < spalten) {
            if (j > 0) {
                result = result + separator;
            }
            let zelle = if (j < rows[i].length) rows[i][j] else "";
            // Die letzte Spalte NICHT auffuellen: sonst haengen unsichtbare Leerzeichen am
            // Zeilenende, und die sieht man erst im Diff.
            result = result + (if (j == spalten - 1) zelle else padEnd(zelle, breiten[j], ' '));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}
