// std.string — building strings.
//
// The f-string lowering uses these functions too: `f"n={x}"` becomes `concat("n=", fromInt(x))`.
// The compiler references them without the user importing `std.string`.
//
// They sit in an ordinary, documented module rather than a hidden compiler module, which would be
// a second notion of what a module is.
//
// The names distinguish by source type (`fromInt`, `fromFloat`, …) rather than being overloads;
// there is no overloading.

module std.string;

pub fn concat(a: string, b: string): string;

pub fn fromInt(value: int): string;

// A separate converter for unsigned numbers: 'fromInt' would read a large 'uint' as a negative
// number.
pub fn fromUint(value: uint): string;
pub fn fromFloat(value: float): string;
pub fn fromBool(value: bool): string;
pub fn fromChar(value: char): string;

// 'ab' * 3. A function rather than an opcode: repetition is library work, and a 'mul' opcode
// doing something else for string than for int would be polymorphic dispatch.
pub fn repeat(value: string, count: int): string;

// --- queries ------------------------------------------------------------------------------
//
// Every position and length counts CODE POINTS, the same unit iteration yields. Counting UTF-16
// units instead would contradict the type system, in which a char is one code point.
//
// There is deliberately no 's[i]'. Access at a code-point position is O(n), and an index operator
// would make the obvious loop quadratic without showing it. Walk characters with 'for (c in s)'.

pub fn length(value: string): int;
pub fn charAt(value: string, index: int): char;
pub fn substring(value: string, start: int, count: int): string;

// Position in code points, or -1, so the result can be passed straight to 'charAt' and
// 'substring'.
pub fn indexOf(value: string, needle: string): int;
pub fn contains(value: string, needle: string): bool;
pub fn startsWith(value: string, prefix: string): bool;
pub fn endsWith(value: string, suffix: string): bool;

pub fn trim(value: string): string;

// Ordinal rather than culture-dependent: the same program yields the same result everywhere.
pub fn toUpper(value: string): string;
pub fn toLower(value: string): string;

// An empty separator is a panic: "split into what" has no answer.
pub fn split(value: string, separator: string): string[];

// What 'for (c in s)' uses: one O(n) pass instead of n calls to 'charAt'.
pub fn toChars(value: string): char[];

// ================================================================== written in Lyric
//
// Nothing below is native. Everything builds on the primitives above — `length`, `charAt`,
// `substring`, `concat` — and otherwise computes with code points.
//
// That works because a `char` is a number, so `isDigit` and `parseInt` are ordinary arithmetic.
// Otherwise each of them would need a native signature, and every native signature is a line in
// the bytecode contract.
//
// This module imports nothing and must not: `std.core` imports `std.string`. There is therefore
// no `List<T>` and no `Iterator<T>` here; collecting happens into an array.
// `string[]`.

// ------------------------------------------------------------------ Zeichen pruefen
//
// All take a `char` rather than a `string`: the question is asked of a character.

pub fn isDigit(c: char): bool {
    return c >= '0' && c <= '9';
}

// ASCII only. A full Unicode category would need the tables from the standard.
pub fn isAlpha(c: char): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

pub fn isAlphanumeric(c: char): bool {
    return isAlpha(c) || isDigit(c);
}

pub fn isWhitespace(c: char): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

pub fn isUpper(c: char): bool {
    return c >= 'A' && c <= 'Z';
}

pub fn isLower(c: char): bool {
    return c >= 'a' && c <= 'z';
}

/// The numeric value of a digit, or `null` when it is not one.
///
/// `?int` rather than `-1`: a failure the caller has to handle belongs in the type.
pub fn charToDigit(c: char): ?int {
    if (!isDigit(c)) {
        return null;
    }
    return (c as int) - ('0' as int);
}

pub fn digitToChar(value: int): ?char {
    if (value < 0 || value > 9) {
        return null;
    }
    return (('0' as int) + value) as char;
}

// ------------------------------------------------------------------ Praedikate

pub fn isEmpty(value: string): bool {
    return length(value) == 0;
}

/// Empty or whitespace only.
pub fn isBlank(value: string): bool {
    var i = 0;
    let n = length(value);
    while (i < n) {
        if (!isWhitespace(charAt(value, i))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ------------------------------------------------------------------ Suchen

/// Searches from a position. `-1` when nothing is found, as in `indexOf`.
pub fn indexOfFrom(value: string, needle: string, start: int): int {
    let n = length(value);
    let m = length(needle);
    if (m == 0) {
        return if (start <= n) start else -1;
    }

    var i = if (start < 0) 0 else start;
    while (i + m <= n) {
        if (substring(value, i, m) == needle) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Das LETZTE Vorkommen.
pub fn lastIndexOf(value: string, needle: string): int {
    let n = length(value);
    let m = length(needle);
    if (m == 0) {
        return n;
    }

    var i = n - m;
    while (i >= 0) {
        if (substring(value, i, m) == needle) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

/// Wie oft `needle` vorkommt — OHNE Ueberlappung.
///
/// Overlapping occurrences are not counted: `count("aaa", "aa")` is 1, not 2. This matches
/// `replace`.
pub fn count(value: string, needle: string): int {
    if (length(needle) == 0) {
        return 0;
    }

    var n = 0;
    var i = indexOfFrom(value, needle, 0);
    while (i >= 0) {
        n = n + 1;
        i = indexOfFrom(value, needle, i + length(needle));
    }
    return n;
}

// ------------------------------------------------------------------ splitting and joining

/// Joins the parts with a separator: the inverse of `split`.
pub fn join(parts: string[], separator: string): string {
    if (parts.length == 0) {
        return "";
    }

    var result = parts[0];
    var i = 1;
    while (i < parts.length) {
        result = result + separator + parts[i];
        i = i + 1;
    }
    return result;
}

/// Splits at line breaks. Both `\r\n` and `\n` count.
pub fn splitLines(value: string): string[] {
    // Remove the carriage returns first, then split at `\n`.
    return split(replace(value, "\r\n", "\n"), "\n");
}

/// Splits at the FIRST occurrence; the rest stays whole, for `key=value=more`.
pub fn splitFirst(value: string, separator: string): string[] {
    let i = indexOf(value, separator);
    if (i < 0) {
        return [value];
    }
    let davor = substring(value, 0, i);
    let danach = substring(value, i + length(separator),
                           length(value) - i - length(separator));
    return [davor, danach];
}

pub fn replace(value: string, needle: string, ersatz: string): string {
    if (length(needle) == 0) {
        return value;
    }

    var result = "";
    var i = 0;
    let n = length(value);
    let m = length(needle);

    while (i < n) {
        if (i + m <= n && substring(value, i, m) == needle) {
            result = result + ersatz;
            i = i + m;
        } else {
            result = result + fromChar(charAt(value, i));
            i = i + 1;
        }
    }
    return result;
}

pub fn replaceFirst(value: string, needle: string, ersatz: string): string {
    let i = indexOf(value, needle);
    if (i < 0) {
        return value;
    }
    let davor = substring(value, 0, i);
    let danach = substring(value, i + length(needle),
                           length(value) - i - length(needle));
    return davor + ersatz + danach;
}

// ------------------------------------------------------------------ trimming and padding

pub fn trimStart(value: string): string {
    var i = 0;
    let n = length(value);
    while (i < n && isWhitespace(charAt(value, i))) {
        i = i + 1;
    }
    return substring(value, i, n - i);
}

pub fn trimEnd(value: string): string {
    var n = length(value);
    while (n > 0 && isWhitespace(charAt(value, n - 1))) {
        n = n - 1;
    }
    return substring(value, 0, n);
}

/// Pads at the front until `width` is reached. A longer string is left unchanged; truncating
/// would lose data in a function that only formats.
pub fn padStart(value: string, width: int, fill: char): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    return repeat(fromChar(fill), fehlend) + value;
}

pub fn padEnd(value: string, width: int, fill: char): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    return value + repeat(fromChar(fill), fehlend);
}

// ------------------------------------------------------------------ Parsen
//
// All return `?T`: an unparsable string is an ordinary state of the world, not a programming
// error.

/// `"-42"` becomes `-42`, anything else `null`.
///
/// No overflow protection: a number beyond `int64` wraps rather than yielding `null`. Detecting
/// it would need a division per digit.
pub fn parseInt(value: string): ?int {
    let n = length(value);
    if (n == 0) {
        return null;
    }

    var i = 0;
    var negativ = false;
    let erstes = charAt(value, 0);
    if (erstes == '-' || erstes == '+') {
        negativ = erstes == '-';
        i = 1;
    }

    // A sign on its own is not a number.
    if (i >= n) {
        return null;
    }

    var ergebnis = 0;
    while (i < n) {
        let ziffer = charToDigit(charAt(value, i));
        if (ziffer == null) {
            return null;
        }
        ergebnis = ergebnis * 10 + ziffer;
        i = i + 1;
    }

    return if (negativ) 0 - ergebnis else ergebnis;
}

/// From a base of 2 to 36. Letters continue from `a`/`A`.
pub fn parseIntRadix(value: string, radix: int): ?int {
    if (radix < 2 || radix > 36) {
        return null;
    }

    let n = length(value);
    if (n == 0) {
        return null;
    }

    var i = 0;
    var negativ = false;
    let erstes = charAt(value, 0);
    if (erstes == '-' || erstes == '+') {
        negativ = erstes == '-';
        i = 1;
    }
    if (i >= n) {
        return null;
    }

    var ergebnis = 0;
    while (i < n) {
        let c = charAt(value, i);
        var wert = -1;
        if (isDigit(c)) {
            wert = (c as int) - ('0' as int);
        } else if (isLower(c)) {
            wert = (c as int) - ('a' as int) + 10;
        } else if (isUpper(c)) {
            wert = (c as int) - ('A' as int) + 10;
        }

        if (wert < 0 || wert >= radix) {
            return null;
        }
        ergebnis = ergebnis * radix + wert;
        i = i + 1;
    }

    return if (negativ) 0 - ergebnis else ergebnis;
}

pub fn parseBool(value: string): ?bool {
    if (value == "true") {
        return true;
    }
    if (value == "false") {
        return false;
    }
    return null;
}

/// `"3.5"`, `"-0.25"`, `"42"` werden Fliesskomma; alles andere `null`.
///
/// Without exponent notation (`1e9`), which would need a state machine of its own.
pub fn parseFloat(value: string): ?float {
    let punkt = indexOf(value, ".");
    if (punkt < 0) {
        let ganz = parseInt(value);
        if (ganz == null) {
            return null;
        }
        return ganz as float;
    }

    let vorne = substring(value, 0, punkt);
    let hinten = substring(value, punkt + 1, length(value) - punkt - 1);
    if (length(hinten) == 0) {
        return null;
    }

    var ganzzahl = 0;
    var negativ = false;
    if (length(vorne) > 0) {
        if (vorne == "-") {
            negativ = true;
        } else {
            let g = parseInt(vorne);
            if (g == null) {
                return null;
            }
            ganzzahl = g;
            negativ = charAt(vorne, 0) == '-';
        }
    }

    // The fractional digits one at a time, so no sign gets into them.
    var bruch = 0.0;
    var teiler = 1.0;
    var i = 0;
    while (i < length(hinten)) {
        let ziffer = charToDigit(charAt(hinten, i));
        if (ziffer == null) {
            return null;
        }
        teiler = teiler * 10.0;
        bruch = bruch + (ziffer as float) / teiler;
        i = i + 1;
    }

    let betrag = absFloat(ganzzahl as float) + bruch;
    return if (negativ) 0.0 - betrag else betrag;
}

// Local, so this module need not import `std.math`.
fn absFloat(value: float): float {
    return if (value < 0.0) 0.0 - value else value;
}

// ------------------------------------------------------------------ Bauen

pub fn fromChars(chars: char[]): string {
    var result = "";
    var i = 0;
    while (i < chars.length) {
        result = result + fromChar(chars[i]);
        i = i + 1;
    }
    return result;
}

/// Builds a string piece by piece.
///
/// `s = s + part` in a loop is quadratic: every step copies the whole string so far. The builder
/// collects the parts and joins them once.
///
/// The backing is a doubling `string[]`, written by hand because this module must not import
/// `std.collections`.
pub class StringBuilder {
    parts: string[],
    count: int,

    pub fn length(): int {
        return this.count;
    }

    pub mut fn append(value: string): void {
        if (this.count == this.parts.length) {
            let groesser = [""] * (if (this.parts.length == 0) 4 else this.parts.length * 2);
            var i = 0;
            while (i < this.count) {
                groesser[i] = this.parts[i];
                i = i + 1;
            }
            this.parts = groesser;
        }
        this.parts[this.count] = value;
        this.count = this.count + 1;
    }

    pub mut fn appendLine(value: string): void {
        this.append(value);
        this.append("\n");
    }

    pub mut fn appendChar(value: char): void {
        this.append(fromChar(value));
    }

    pub fn build(): string {
        var result = "";
        var i = 0;
        while (i < this.count) {
            result = result + this.parts[i];
            i = i + 1;
        }
        return result;
    }
}

pub fn newStringBuilder(): StringBuilder {
    return StringBuilder { parts = [""] * 4, count = 0 };
}
