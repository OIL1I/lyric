// std.string — String-Bau.
//
// Diese Funktionen benutzt auch das f-String-Lowering: `f"n={x}"` wird zu
// `concat("n=", fromInt(x))`. Der Compiler referenziert sie also, ohne dass der Nutzer
// `std.string` importiert hat — dasselbe Modell wie Roslyns Verweis auf `String.Concat`.
//
// Sie stehen bewusst in einem normalen, dokumentierten Modul und nicht in einem versteckten
// Compiler-Modul: ein `lyric.rt`, das niemand importieren darf, wäre ein zweiter Modul-Begriff
// für dieselbe Sache.
//
// Die Namen unterscheiden nach Quelltyp (`fromInt`, `fromFloat`, …) statt vier gleichnamige
// Überladungen zu sein — Lyric hat kein Overloading.

module std.string;

pub fn concat(a: string, b: string): string;

pub fn fromInt(value: int): string;

// Eigener Wandler fuer vorzeichenlose Zahlen. 'fromInt' deutet ein grosses 'uint' als negative
// Zahl um — gemessen lieferte f"{u}" mit u = uint64.MaxValue vorher "-1". Zwei Namen, weil Lyric
// kein Overloading hat (ADR-015).
pub fn fromUint(value: uint): string;
pub fn fromFloat(value: float): string;
pub fn fromBool(value: bool): string;
pub fn fromChar(value: char): string;

// 'ab' * 3 aus Sprache.md §6.5. Eigene Funktion und kein Opcode: die Wiederholung ist
// Bibliotheksarbeit, und ein 'mul'-Opcode, der bei string etwas anderes taete als bei int, waere
// genau der polymorphe Dispatch, den ADR-013 vermeidet.
pub fn repeat(value: string, count: int): string;

// --- Abfragen (M8/S2) --------------------------------------------------------------------
//
// Alle Positionen und Laengen zaehlen CODEPOINTS. Sprache.md §4 sagt "char = ein Unicode-
// Codepoint", also muss eine Laenge dasselbe zaehlen, was die Iteration liefert — sonst
// widerspraeche sich das Typsystem selbst. C#, Java und JavaScript zaehlen UTF-16-Einheiten und
// haben genau diesen Widerspruch; dort ist die Laenge eines Emoji 2.
//
// Es gibt bewusst KEIN 's[i]'. Der Zugriff auf eine Codepoint-Position ist O(n), und mit einem
// Indexoperator wuerde die naheliegende Schleife quadratisch, ohne dass man es ihr ansieht.
// Rust verbietet die Indizierung aus demselben Grund. Wer ueber Zeichen laufen will, nimmt
// 'for (c in s)' — das ist linear und liest sich besser.

pub fn length(value: string): int;
pub fn charAt(value: string, index: int): char;
pub fn substring(value: string, start: int, count: int): string;

// Position in Codepoints, oder -1. Der Rueckgabewert ist damit direkt als Argument fuer
// 'charAt' und 'substring' brauchbar — bei einer Position in Bytes oder UTF-16-Einheiten waere
// er das nicht.
pub fn indexOf(value: string, needle: string): int;
pub fn contains(value: string, needle: string): bool;
pub fn startsWith(value: string, prefix: string): bool;
pub fn endsWith(value: string, suffix: string): bool;

pub fn trim(value: string): string;

// Ordinal, nicht kulturabhaengig: dasselbe Programm liefert auf jeder Maschine dasselbe.
pub fn toUpper(value: string): string;
pub fn toLower(value: string): string;

// Ein leerer Trenner ist ein panic, kein Sonderfall — die Frage "in was soll ich teilen" hat
// dann keine Antwort, und .NET und Python sind sich uneinig, welche sie erfinden.
pub fn split(value: string, separator: string): string[];

// Was 'for (c in s)' benutzt. Einmal O(n) statt n-mal O(n): ein Iterator, der 'charAt' riefe,
// waere quadratisch.
pub fn toChars(value: string): char[];

// ====================================================== In Lyric geschrieben (M8b/S5)
//
// Ab hier ist nichts mehr nativ. Alles baut auf den Primitiven darueber auf — `length`, `charAt`,
// `substring`, `concat` — und rechnet ansonsten mit Codepoints.
//
// **Dass das geht, haengt an ADR-022**: seit `char` eine Zahl ist, sind `isDigit` und `parseInt`
// gewoehnliche Arithmetik. Vorher haette jede dieser Funktionen eine native Signatur gebraucht,
// und jede native Signatur ist eine Zeile im Bytecode-Vertrag (ADR-013).
//
// **Dieses Modul importiert nichts** und darf auch nichts importieren: `std.core` importiert
// `std.string`. Deshalb gibt es hier kein `List<T>` und keinen `Iterator<T>` — gesammelt wird in
// `string[]`.

// ------------------------------------------------------------------ Zeichen pruefen
//
// Alle nehmen `char` und nicht `string`: die Frage "ist das eine Ziffer?" stellt sich an einem
// Zeichen, und ein Ein-Zeichen-String waere eine Verpackung ohne Zweck.

pub fn isDigit(c: char): bool {
    return c >= '0' && c <= '9';
}

// Nur ASCII. Eine vollstaendige Unicode-Kategorie braeuchte die Tabellen aus dem Standard, und die
// gehoeren nicht in eine Sprache, die ohne Datendateien auskommen soll.
pub fn isAlpha(c: char): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

pub fn isAlphanumeric(c: char): bool {
    return isAlpha(c) || isDigit(c);
}

pub fn isWhitespace(c: char): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

pub fn isUpper(c: char): bool {
    return c >= 'A' && c <= 'Z';
}

pub fn isLower(c: char): bool {
    return c >= 'a' && c <= 'z';
}

/// Der Zahlwert einer Ziffer — `null`, wenn es keine ist.
///
/// `?int` und nicht `-1`: ein Fehlschlag, den der Aufrufer behandeln muss, gehoert in den Typ.
pub fn charToDigit(c: char): ?int {
    if (!isDigit(c)) {
        return null;
    }
    return (c as int) - ('0' as int);
}

pub fn digitToChar(value: int): ?char {
    if (value < 0 || value > 9) {
        return null;
    }
    return (('0' as int) + value) as char;
}

// ------------------------------------------------------------------ Praedikate

pub fn isEmpty(value: string): bool {
    return length(value) == 0;
}

/// Leer oder nur Weissraum.
pub fn isBlank(value: string): bool {
    var i = 0;
    let n = length(value);
    while (i < n) {
        if (!isWhitespace(charAt(value, i))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ------------------------------------------------------------------ Suchen

/// Ab einer Position suchen. `-1`, wenn nichts gefunden wird — wie `indexOf`.
pub fn indexOfFrom(value: string, needle: string, start: int): int {
    let n = length(value);
    let m = length(needle);
    if (m == 0) {
        return if (start <= n) start else -1;
    }

    var i = if (start < 0) 0 else start;
    while (i + m <= n) {
        if (substring(value, i, m) == needle) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Das LETZTE Vorkommen.
pub fn lastIndexOf(value: string, needle: string): int {
    let n = length(value);
    let m = length(needle);
    if (m == 0) {
        return n;
    }

    var i = n - m;
    while (i >= 0) {
        if (substring(value, i, m) == needle) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

/// Wie oft `needle` vorkommt — OHNE Ueberlappung.
///
/// Das ist eine Entscheidung, keine Selbstverstaendlichkeit: `count("aaa", "aa")` ist damit 1 und
/// nicht 2. Beides ist vertretbar; diese Variante ist die von `replace`, und zwei verschiedene
/// Antworten auf "wo kommt es vor?" waeren schlimmer als eine unbequeme.
pub fn count(value: string, needle: string): int {
    if (length(needle) == 0) {
        return 0;
    }

    var n = 0;
    var i = indexOfFrom(value, needle, 0);
    while (i >= 0) {
        n = n + 1;
        i = indexOfFrom(value, needle, i + length(needle));
    }
    return n;
}

// ------------------------------------------------------------------ Zerlegen und Fuegen

/// Fuegt die Teile mit einem Trenner zusammen — die Umkehrung von `split`.
///
/// Fehlte bisher und wird staendig gebraucht; ohne sie schreibt jeder seine eigene Schleife, und
/// die Haelfte davon haengt den Trenner einmal zu oft an.
pub fn join(parts: string[], separator: string): string {
    if (parts.length == 0) {
        return "";
    }

    var result = parts[0];
    var i = 1;
    while (i < parts.length) {
        result = result + separator + parts[i];
        i = i + 1;
    }
    return result;
}

/// Zerlegt an Zeilenumbruechen. `\r\n` und `\n` zaehlen beide.
pub fn splitLines(value: string): string[] {
    // Erst die Wagenruecklaeufe entfernen, dann an `\n` trennen: die Alternative waere eine eigene
    // Schleife mit zwei Faellen, und die haette einen dritten uebersehen.
    return split(replace(value, "\r\n", "\n"), "\n");
}

/// Am ERSTEN Vorkommen trennen. Der Rest bleibt ungeteilt — fuer `key=value=mehr`.
pub fn splitFirst(value: string, separator: string): string[] {
    let i = indexOf(value, separator);
    if (i < 0) {
        return [value];
    }
    let davor = substring(value, 0, i);
    let danach = substring(value, i + length(separator),
                           length(value) - i - length(separator));
    return [davor, danach];
}

pub fn replace(value: string, needle: string, ersatz: string): string {
    if (length(needle) == 0) {
        return value;
    }

    var result = "";
    var i = 0;
    let n = length(value);
    let m = length(needle);

    while (i < n) {
        if (i + m <= n && substring(value, i, m) == needle) {
            result = result + ersatz;
            i = i + m;
        } else {
            result = result + fromChar(charAt(value, i));
            i = i + 1;
        }
    }
    return result;
}

pub fn replaceFirst(value: string, needle: string, ersatz: string): string {
    let i = indexOf(value, needle);
    if (i < 0) {
        return value;
    }
    let davor = substring(value, 0, i);
    let danach = substring(value, i + length(needle),
                           length(value) - i - length(needle));
    return davor + ersatz + danach;
}

// ------------------------------------------------------------------ Trimmen und Fuellen

pub fn trimStart(value: string): string {
    var i = 0;
    let n = length(value);
    while (i < n && isWhitespace(charAt(value, i))) {
        i = i + 1;
    }
    return substring(value, i, n - i);
}

pub fn trimEnd(value: string): string {
    var n = length(value);
    while (n > 0 && isWhitespace(charAt(value, n - 1))) {
        n = n - 1;
    }
    return substring(value, 0, n);
}

/// Fuellt vorn auf, bis `width` erreicht ist. Ein laengerer String bleibt unveraendert —
/// abschneiden waere Datenverlust an einer Stelle, die nur formatiert.
pub fn padStart(value: string, width: int, fill: char): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    return repeat(fromChar(fill), fehlend) + value;
}

pub fn padEnd(value: string, width: int, fill: char): string {
    let fehlend = width - length(value);
    if (fehlend <= 0) {
        return value;
    }
    return value + repeat(fromChar(fill), fehlend);
}

// ------------------------------------------------------------------ Parsen
//
// Alle liefern `?T`: ein unparsbarer String ist ein gewoehnlicher Zustand der Welt (Nutzereingabe,
// Konfigurationsdatei) und kein Programmierfehler. Dieselbe Entscheidung wie bei `readText`.

/// `"-42"` wird `-42`, alles andere `null`.
///
/// **Kein Ueberlaufschutz**: eine Zahl jenseits von `int64` wickelt um (§6.6), statt `null` zu
/// liefern. Das zu erkennen braeuchte eine Division je Ziffer, und die Sprache hat kein `checked`.
/// Bewusst so und hier vermerkt, statt es zu verschweigen.
pub fn parseInt(value: string): ?int {
    let n = length(value);
    if (n == 0) {
        return null;
    }

    var i = 0;
    var negativ = false;
    let erstes = charAt(value, 0);
    if (erstes == '-' || erstes == '+') {
        negativ = erstes == '-';
        i = 1;
    }

    // Nur ein Vorzeichen ist keine Zahl.
    if (i >= n) {
        return null;
    }

    var ergebnis = 0;
    while (i < n) {
        let ziffer = charToDigit(charAt(value, i));
        if (ziffer == null) {
            return null;
        }
        ergebnis = ergebnis * 10 + ziffer;
        i = i + 1;
    }

    return if (negativ) 0 - ergebnis else ergebnis;
}

/// Zu einer Basis von 2 bis 36. Buchstaben zaehlen ab `a`/`A` weiter.
pub fn parseIntRadix(value: string, radix: int): ?int {
    if (radix < 2 || radix > 36) {
        return null;
    }

    let n = length(value);
    if (n == 0) {
        return null;
    }

    var i = 0;
    var negativ = false;
    let erstes = charAt(value, 0);
    if (erstes == '-' || erstes == '+') {
        negativ = erstes == '-';
        i = 1;
    }
    if (i >= n) {
        return null;
    }

    var ergebnis = 0;
    while (i < n) {
        let c = charAt(value, i);
        var wert = -1;
        if (isDigit(c)) {
            wert = (c as int) - ('0' as int);
        } else if (isLower(c)) {
            wert = (c as int) - ('a' as int) + 10;
        } else if (isUpper(c)) {
            wert = (c as int) - ('A' as int) + 10;
        }

        if (wert < 0 || wert >= radix) {
            return null;
        }
        ergebnis = ergebnis * radix + wert;
        i = i + 1;
    }

    return if (negativ) 0 - ergebnis else ergebnis;
}

pub fn parseBool(value: string): ?bool {
    if (value == "true") {
        return true;
    }
    if (value == "false") {
        return false;
    }
    return null;
}

/// `"3.5"`, `"-0.25"`, `"42"` werden Fliesskomma; alles andere `null`.
///
/// Ohne Exponentenschreibweise (`1e9`) — die braeuchte eine eigene Zustandsmaschine, und wer sie
/// wirklich braucht, hat meist auch andere Anforderungen an die Genauigkeit.
pub fn parseFloat(value: string): ?float {
    let punkt = indexOf(value, ".");
    if (punkt < 0) {
        let ganz = parseInt(value);
        if (ganz == null) {
            return null;
        }
        return ganz as float;
    }

    let vorne = substring(value, 0, punkt);
    let hinten = substring(value, punkt + 1, length(value) - punkt - 1);
    if (length(hinten) == 0) {
        return null;
    }

    var ganzzahl = 0;
    var negativ = false;
    if (length(vorne) > 0) {
        if (vorne == "-") {
            negativ = true;
        } else {
            let g = parseInt(vorne);
            if (g == null) {
                return null;
            }
            ganzzahl = g;
            negativ = charAt(vorne, 0) == '-';
        }
    }

    // Nachkommastellen einzeln, damit kein Vorzeichen hineingeraet und "1.-2" scheitert.
    var bruch = 0.0;
    var teiler = 1.0;
    var i = 0;
    while (i < length(hinten)) {
        let ziffer = charToDigit(charAt(hinten, i));
        if (ziffer == null) {
            return null;
        }
        teiler = teiler * 10.0;
        bruch = bruch + (ziffer as float) / teiler;
        i = i + 1;
    }

    let betrag = absFloat(ganzzahl as float) + bruch;
    return if (negativ) 0.0 - betrag else betrag;
}

// Lokal, damit dieses Modul `std.math` nicht importieren muss.
fn absFloat(value: float): float {
    return if (value < 0.0) 0.0 - value else value;
}

// ------------------------------------------------------------------ Bauen

pub fn fromChars(chars: char[]): string {
    var result = "";
    var i = 0;
    while (i < chars.length) {
        result = result + fromChar(chars[i]);
        i = i + 1;
    }
    return result;
}

/// Baut einen String stueckweise auf.
///
/// **Warum es die Klasse gibt**: `s = s + teil` in einer Schleife ist quadratisch — jeder Schritt
/// kopiert den ganzen bisherigen String. Der Builder sammelt die Teile und fuegt sie EINMAL
/// zusammen. `Doku.md` erwaehnt ihn seit M6; es gab ihn nur nie.
///
/// Das Backing ist ein `string[]`, das sich verdoppelt — dieselbe Strategie wie `List<T>`, hier
/// von Hand, weil dieses Modul `std.collections` nicht importieren darf.
pub class StringBuilder {
    parts: string[],
    count: int,

    pub fn length(): int {
        return this.count;
    }

    pub mut fn append(value: string): void {
        if (this.count == this.parts.length) {
            let groesser = [""] * (if (this.parts.length == 0) 4 else this.parts.length * 2);
            var i = 0;
            while (i < this.count) {
                groesser[i] = this.parts[i];
                i = i + 1;
            }
            this.parts = groesser;
        }
        this.parts[this.count] = value;
        this.count = this.count + 1;
    }

    pub mut fn appendLine(value: string): void {
        this.append(value);
        this.append("\n");
    }

    pub mut fn appendChar(value: char): void {
        this.append(fromChar(value));
    }

    pub fn build(): string {
        var result = "";
        var i = 0;
        while (i < this.count) {
            result = result + this.parts[i];
            i = i + 1;
        }
        return result;
    }
}

pub fn newStringBuilder(): StringBuilder {
    return StringBuilder { parts = [""] * 4, count = 0 };
}
