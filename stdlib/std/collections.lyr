// std.collections — wachsende Container (M8/S5).
//
// `T[]` ist ein echtes Array mit fester Länge (ADR-016). Was wächst, steht hier.

module std.collections;

import std.iter { Iterator, Iterable };
import std.core { Hashable, Equatable, Ordered };

// Was sich mit `[i]` lesen und schreiben lässt.
//
// Dasselbe Modell wie `Iterator<T>` für `for-in` (§5): der Compiler kennt eine eingebaute Form —
// dort den Range, hier das Array — und bindet alles andere an ein Interface aus der Stdlib. Kein
// Sonderfall im Compiler pro Container-Typ.
//
// **`set` ist `mut`, und das kostet seit ADR-020 nichts.** `let` bindet den Namen, nicht den
// Inhalt; ein Container hinter einer `let`-Bindung ist deshalb schreibbar, genau wie ein
// Klassenfeld. Vor ADR-020 hätte dieses Interface eine Sonderregel nachbilden müssen, die noch
// dazu wirkungslos war — das war der Anlass, die Frage vorher zu entscheiden.
//
// **`get` und `set` sind O(1).** Das ist eine Zusicherung, keine Beschreibung: eine
// Implementierung mit O(n)-Zugriff — etwa eine verkettete Liste — darf dieses Interface *nicht*
// erfüllen. Sonst würde `for (var i = 0; i < n; i++) xs[i]` quadratisch, ohne dass man es der
// Schleife ansieht. Aus demselben Grund hat `string` keinen Indexoperator (§4).
pub interface Indexable<T> {
    fn get(index: int): T;
    mut fn set(index: int, value: T): void;
}

// Eine wachsende Liste.
//
// **Sie ist in Lyric geschrieben, nicht nativ.** Die ROADMAP sah einen Hook auf
// `System.Collections.Generic.List<>` vor; dagegen sprechen zwei Dinge. Erstens sind Natives
// monomorph registriert — ein generischer bräuchte eine eigene Marshalling-Schicht, und die
// gehört zu M10. Zweitens ist eine Stdlib, die ihre eigenen Container nicht ausdrücken kann, ein
// schlechtes Zeichen für die Sprache.
//
// **Das Backing ist `(?T)[]` und nicht `T[]`.** Der Grund ist nicht Bequemlichkeit, sondern dass
// ein Slot **leerbar** sein muss: `pop` gibt seinen Wert wirklich frei, statt ihn nur hinter
// `count` verschwinden zu lassen. Ohne das hielte die Liste jedes je eingefügte Objekt am Leben,
// und ein `get` daneben läse es sogar zurück. Nebenbei löst es das Erzeugungsproblem — ein `T[]`
// der Länge n bräuchte n Werte vom Typ T, und Lyric hat kein `default(T)`; für `?T` gibt es
// einen, nämlich `null`.
//
// **Wachsen verdoppelt, Schrumpfen halbiert bei einem Viertel.** Verdoppeln macht `push`
// amortisiert O(1) — exaktes Wachsen (`data + [v]`) wäre O(n) pro Aufruf und damit quadratisch
// über die Liste; gemessen bei 50 000 Elementen Faktor 8,6. Die Schrumpf-Schwelle liegt bei
// einem Viertel und nicht bei der Hälfte, damit eine Liste, die um die Grenze pendelt, nicht bei
// jedem `push`/`pop` umkopiert.
pub class List<T> :: [Indexable<T>, Iterable<T>] {
    data: (?T)[],
    count: int,

    pub fn length(): int {
        return this.count;
    }

    // Ein FRISCHER Cursor bei jedem Aufruf — deshalb stoeren zwei Schleifen ueber dieselbe Liste
    // einander nicht. Genau dafuer ist die Trennung von 'Iterable' und 'Iterator' da.
    pub fn iter(): Iterator<T> {
        return ListIterator<T> { source = this, index = 0 };
    }

    // Wie viele Slots belegt sind — inklusive der leeren. Nur für Tests und für den, der wissen
    // will, was die Liste kostet; für alles andere ist `length` die Wahrheit.
    // Map und Set haben das seit ihrem ersten Tag; List fehlte es. Eine Sammlung, bei der man je
    // nach Typ 'length() == 0' oder 'isEmpty()' schreibt, kostet bei jedem Gebrauch eine
    // Nachfrage.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    pub fn capacity(): int {
        return this.data.length;
    }

    mut fn resize(target: int): void {
        let hole: ?T = null;
        let moved = [hole] * target;

        var i = 0;
        while (i < this.count) {
            moved[i] = this.data[i];
            i = i + 1;
        }
        this.data = moved;
    }

    pub mut fn push(value: T): void {
        if (this.count >= this.data.length) {
            if (this.data.length == 0) {
                this.resize(4);
            } else {
                this.resize(this.data.length * 2);
            }
        }
        this.data[this.count] = value;
        this.count = this.count + 1;
    }

    // Der letzte Wert, oder `null` bei leerer Liste. Kein `panic`: eine leere Liste ist ein
    // gewöhnlicher Zustand und kein Programmierfehler — anders als ein Index daneben.
    //
    // Der Slot wird **geleert**, nicht nur übersprungen. Sonst hielte die Liste das Objekt am
    // Leben, und ein `get` an dieser Stelle läse es zurück, obwohl es entfernt ist.
    pub mut fn pop(): ?T {
        if (this.count == 0) {
            return null;
        }

        this.count = this.count - 1;
        let value = this.data[this.count];
        this.data[this.count] = null;

        // Unter einem Viertel: halbieren. Vier Slots bleiben immer stehen — darunter lohnt das
        // Umkopieren nicht und der Gewinn wären ein paar Dutzend Byte.
        if (this.data.length > 4 && this.count * 4 < this.data.length) {
            this.resize(this.data.length / 2);
        }
        return value;
    }

    // Ein Index außerhalb ist ein `panic` (§9), wie bei einem Array: er ist ein Programmierfehler
    // und kein Zustand, über den man sich verständigt.
    //
    // Geprüft wird gegen `count`, **nicht** gegen `data.length` — dahinter stehen leere Slots aus
    // dem Verdoppeln, die niemanden etwas angehen. Genau das war der Fehler der ersten Fassung:
    // sie verließ sich auf die Array-Grenze und gab Reste zurück.
    pub fn get(index: int): T {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        // Kann nie fehlschlagen: innerhalb von `count` steht immer ein Wert. Der Beweis ist die
        // Prüfung darüber — dieselbe Arbeitsteilung wie beim Flow-Narrowing.
        return this.data[index]!;
    }

    pub mut fn set(index: int, value: T): void {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        this.data[index] = value;
    }
}

// Eine leere Liste. Als freie Funktion und nicht als `static fn`, weil eine statische Methode auf
// einer generischen Instanz (`List<int>.empty()`) nicht ausdrückbar ist — die Typargumente gibt
// es nur am Funktions-Aufruf.
pub fn emptyList<T>(): List<T> {
    let hole: ?T = null;
    return List<T> { data = [hole] * 0, count = 0 };
}

// Läuft über eine Liste. Wie `ArrayIterator` hält er seinen Index selbst, damit zwei Schleifen
// über dieselbe Liste einander nicht stören.
pub class ListIterator<T> :: [Iterator<T>] {
    source: List<T>,
    index: int,

    pub mut fn next(): ?T {
        if (this.index >= this.source.length()) {
            return null;
        }
        let value = this.source.get(this.index);
        this.index = this.index + 1;
        return value;
    }
}

/// Sammelt einen Iterator in eine `List<T>`.
///
/// Steht hier und nicht in `std.iter`, weil die Abhaengigkeit dorthin laeuft: `std.collections`
/// importiert `std.iter`, nicht umgekehrt. `std.iter.collectArray` ist die Variante ohne diese
/// Abhaengigkeit — und quadratisch, weil ein `T[]` bei jedem Anhaengen kopiert. Diese hier
/// verdoppelt und ist linear.
pub fn collect<T>(source: Iterator<T>): List<T> {
    var result = emptyList<T>();
    var value = source.next();
    while (value != null) {
        result.push(value);
        value = source.next();
    }
    return result;
}

// ============================================================== Map<K, V> (M8b/S4, ADR-024)
//
// **Open Addressing mit linearer Sondierung.** Kein Bucket pro Slot, sondern ein einziges Array
// je Spalte; bei Kollision geht es zum naechsten Index weiter. Die Alternative — eine verkettete
// Liste je Bucket — braeuchte pro Eintrag ein Objekt und einen Zeiger, und Lyric hat keinen
// Grund, das zu zahlen: Sondierung kommt mit drei flachen Arrays aus.
//
// **Drei Zustaende je Slot** (`states`): 0 leer, 1 belegt, 2 geloescht. Der dritte ist noetig,
// weil ein geloeschter Slot die Sondierungskette nicht unterbrechen darf — sonst faende ein
// `get` einen Schluessel nicht mehr, der hinter der Luecke liegt. Ein *Grabstein* beendet die
// Suche beim Lesen nicht, ist beim Schreiben aber wiederverwendbar.
//
// **Load Factor 3/4**, gemessen an belegten UND geloeschten Slots: Grabsteine kosten Suchzeit wie
// belegte Slots, also muessen sie mitzaehlen. Beim Wachsen verschwinden sie.

pub class Map<K :: [Hashable<K>, Equatable<K>], V> {
    keys: (?K)[],
    values: (?V)[],
    states: int[],
    count: int,      // nur die belegten
    used: int,       // belegte + Grabsteine

    pub fn length(): int {
        return this.count;
    }

    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    // Der Startindex fuer einen Schluessel. Ein Hash darf negativ sein — FNV-1a liefert das
    // regelmaessig —, und `%` folgt in Lyric dem Vorzeichen des Dividenden.
    fn slotOf(key: K): int {
        let h = key.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.keys.length;
    }

    // Sucht den Slot eines Schluessels. Liefert -1, wenn er nicht da ist.
    //
    // Die Schleife endet garantiert: der Load Factor haelt mindestens ein Viertel der Slots frei,
    // und ein leerer Slot beendet die Suche.
    fn findSlot(key: K): int {
        var i = this.slotOf(key);
        let n = this.keys.length;
        var schritte = 0;

        while (schritte < n) {
            if (this.states[i] == 0) {
                return -1;                      // leer: hier haette er stehen muessen
            }
            if (this.states[i] == 1) {
                let vorhanden = this.keys[i];
                if (vorhanden != null && vorhanden.equals(key)) {
                    return i;
                }
            }
            // Grabstein (2): weitergehen, die Kette ist nicht zu Ende.
            i = (i + 1) % n;
            schritte = schritte + 1;
        }
        return -1;
    }

    pub fn containsKey(key: K): bool {
        return this.findSlot(key) >= 0;
    }

    pub fn get(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        return this.values[i];
    }

    pub mut fn set(key: K, value: V): void {
        if ((this.used + 1) * 4 > this.keys.length * 3) {
            this.resize(this.keys.length * 2);
        }

        var i = this.slotOf(key);
        let n = this.keys.length;
        var grabstein = -1;

        while (true) {
            if (this.states[i] == 0) {
                // Erster freier Slot. Ein vorher gesehener Grabstein ist besser: er verkuerzt
                // kuenftige Suchen und erhoeht `used` nicht.
                let ziel = if (grabstein >= 0) grabstein else i;
                this.keys[ziel] = key;
                this.values[ziel] = value;
                this.states[ziel] = 1;
                this.count = this.count + 1;
                if (grabstein < 0) {
                    this.used = this.used + 1;
                }
                return;
            }
            if (this.states[i] == 2) {
                if (grabstein < 0) {
                    grabstein = i;
                }
            } else {
                let vorhanden = this.keys[i];
                if (vorhanden != null && vorhanden.equals(key)) {
                    this.values[i] = value;     // Ueberschreiben, kein neuer Eintrag
                    return;
                }
            }
            i = (i + 1) % n;
        }
    }

    // Entfernt und liefert den alten Wert. Der Slot wird zum Grabstein, nicht zu `leer` — sonst
    // risse die Sondierungskette und ein dahinterliegender Schluessel waere unauffindbar.
    pub mut fn remove(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        let alt = this.values[i];
        this.keys[i] = null;
        this.values[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return alt;
    }

    mut fn resize(capacity: int): void {
        let alteKeys = this.keys;
        let alteValues = this.values;
        let alteStates = this.states;

        let keyHole: ?K = null;
        let valueHole: ?V = null;
        this.keys = [keyHole] * capacity;
        this.values = [valueHole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        // Neu einfuegen statt kopieren: die Slots haengen an der Kapazitaet. Grabsteine fallen
        // dabei weg — das ist der zweite Grund, warum `used` und nicht `count` das Wachsen
        // ausloest.
        var i = 0;
        while (i < alteStates.length) {
            if (alteStates[i] == 1) {
                let k = alteKeys[i];
                let v = alteValues[i];
                if (k != null && v != null) {
                    this.set(k, v);
                }
            }
            i = i + 1;
        }
    }
}

pub fn emptyMap<K :: [Hashable<K>, Equatable<K>], V>(): Map<K, V> {
    let keyHole: ?K = null;
    let valueHole: ?V = null;
    // Acht Slots als Start: klein genug, dass eine leere Map nichts kostet, gross genug, dass die
    // ersten Einfuegungen nicht sofort zwei Verdopplungen ausloesen.
    return Map<K, V> {
        keys = [keyHole] * 8,
        values = [valueHole] * 8,
        states = [0] * 8,
        count = 0,
        used = 0,
    };
}

// ================================================================ Sortieren (M8b/S4)
//
// **Bottom-up Merge Sort**, in Lyric.
//
// Warum Merge und nicht Quicksort: er ist STABIL — gleiche Elemente behalten ihre Reihenfolge —
// und garantiert O(n log n) auch im schlechtesten Fall. Quicksort ist in der Praxis schneller,
// aber instabil, und bei bereits sortierter Eingabe quadratisch. Fuer eine Standardbibliothek ist
// das die falsche Ueberraschung: „mein Programm haengt, seit die Daten sortiert ankommen" ist ein
// Fehlerbild, das niemand sucht.
//
// Dieselbe Wahl treffen alle Sprachen fuer ihre stabile Sortierung: Pythons und Javas Timsort,
// C++ `stable_sort`, Gos `sort.Stable`. Timsort ist im Kern ein Merge Sort mit Erkennung bereits
// sortierter Abschnitte; wer die spaeter nachruesten will, erweitert diesen Code und ersetzt ihn
// nicht.
//
// **Bottom-up und nicht rekursiv**: die Schleifenstruktur steht direkt da — Breite 1, 2, 4, …,
// und in jeder Runde werden benachbarte Paare verschmolzen. Kein Aufrufstack, dessen Tiefe von
// der Eingabegroesse abhaengt.
//
// **Der Preis** ist ein Puffer von der Groesse der Liste. In-place stabil zu sortieren geht, ist
// aber deutlich verwickelter — und Speicher ist hier nicht die knappe Ressource.
//
// Zwei Namen statt eines, weil Lyric kein Overloading hat (ADR-015): `sortList` nach der
// natuerlichen Ordnung, `sortListBy` mit eigenem Vergleich.

/// Sortiert an Ort und Stelle nach der natürlichen Ordnung des Typs.
pub fn sortList<T :: [Ordered<T>]>(xs: List<T>): void {
    sortListBy<T>(xs, (a: T, b: T) => a.compare(b) < 0);
}

/// Sortiert an Ort und Stelle mit einem eigenen Vergleich.
///
/// `less(a, b)` muss `true` liefern, wenn `a` **echt** vor `b` kommt. Ein `less`, das bei
/// gleichen Elementen `true` liefert, zerstört die Stabilität — und bei einem widersprüchlichen
/// `less` (`less(a,b)` und `less(b,a)` beide wahr) ist die Ausgabe beliebig, aber es stürzt
/// nichts ab: der Algorithmus vergleicht nur, er zieht keine Schlüsse.
pub fn sortListBy<T>(xs: List<T>, less: fn(T, T) -> bool): void {
    let n = xs.length();
    if (n < 2) {
        return;
    }

    let hole: ?T = null;
    var buffer = [hole] * n;

    var width = 1;
    while (width < n) {
        var start = 0;
        while (start < n) {
            // Zwei benachbarte, bereits sortierte Laeufe: [start, mitte) und [mitte, ende).
            let mitte = min(start + width, n);
            let ende = min(start + width * 2, n);
            mergeRuns<T>(xs, buffer, start, mitte, ende, less);
            start = start + width * 2;
        }

        // Zurueckschreiben nach jeder Runde. Die Alternative — Quelle und Puffer die Rollen
        // tauschen lassen — spart die Haelfte der Kopien, verlangt aber, am Ende zu wissen, in
        // welchem der beiden das Ergebnis liegt. Diese Buchhaltung ist der haeufigste Fehler in
        // Merge-Sort-Implementierungen; sie ist hier bewusst nicht da.
        var i = 0;
        while (i < n) {
            let v = buffer[i];
            if (v != null) {
                xs.set(i, v);
            }
            i = i + 1;
        }

        width = width * 2;
    }
}

// Verschmilzt [start, mitte) und [mitte, ende) aus `xs` nach `buffer`.
fn mergeRuns<T>(xs: List<T>, buffer: (?T)[], start: int, mitte: int, ende: int,
                less: fn(T, T) -> bool): void {
    var links = start;
    var rechts = mitte;
    var ziel = start;

    while (links < mitte && rechts < ende) {
        let a = xs.get(links);
        let b = xs.get(rechts);

        // `less(b, a)` und nicht `less(a, b)`: bei Gleichstand ist das Ergebnis `false`, also
        // gewinnt die LINKE Seite — und links steht, was vorher weiter vorn stand. Genau daran
        // haengt die Stabilitaet, und die umgekehrte Frage waere ebenso plausibel und falsch.
        let p = less;
        if (p(b, a)) {
            buffer[ziel] = b;
            rechts = rechts + 1;
        } else {
            buffer[ziel] = a;
            links = links + 1;
        }
        ziel = ziel + 1;
    }

    while (links < mitte) {
        buffer[ziel] = xs.get(links);
        links = links + 1;
        ziel = ziel + 1;
    }

    while (rechts < ende) {
        buffer[ziel] = xs.get(rechts);
        rechts = rechts + 1;
        ziel = ziel + 1;
    }
}

fn min(a: int, b: int): int {
    return if (a < b) a else b;
}

// ================================================================== Set<T> (M8b/S4)
//
// Dieselbe Sondierung wie `Map`, nur ohne Werte-Spalte.
//
// **Nicht als `Map<T, bool>` gebaut**, obwohl das kuerzer waere: das verschwendet ein Array, und
// `add(x)` hiesse `set(x, true)` — eine Schreibweise, die an jeder Aufrufstelle erklaert werden
// muesste. Die Duplikation der Sondierungslogik ist der ehrlichere Preis; sie steht daneben und
// laesst sich vergleichen, statt sich hinter einer Umdeutung zu verstecken.

pub class Set<T :: [Hashable<T>, Equatable<T>]> {
    items: (?T)[],
    states: int[],
    count: int,
    used: int,

    pub fn length(): int {
        return this.count;
    }

    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    fn slotOf(value: T): int {
        let h = value.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.items.length;
    }

    fn findSlot(value: T): int {
        var i = this.slotOf(value);
        let n = this.items.length;
        var schritte = 0;

        while (schritte < n) {
            if (this.states[i] == 0) {
                return -1;
            }
            if (this.states[i] == 1) {
                let vorhanden = this.items[i];
                if (vorhanden != null && vorhanden.equals(value)) {
                    return i;
                }
            }
            i = (i + 1) % n;
            schritte = schritte + 1;
        }
        return -1;
    }

    pub fn contains(value: T): bool {
        return this.findSlot(value) >= 0;
    }

    /// Fügt hinzu und liefert `true`, wenn der Wert **neu** war.
    ///
    /// Der Rückgabewert ist nicht Zierde: „war das schon drin?" ist die Frage, für die man sonst
    /// ein `contains` davorsetzt — und damit zweimal sondiert.
    pub mut fn add(value: T): bool {
        if ((this.used + 1) * 4 > this.items.length * 3) {
            this.resize(this.items.length * 2);
        }

        var i = this.slotOf(value);
        let n = this.items.length;
        var grabstein = -1;

        while (true) {
            if (this.states[i] == 0) {
                let ziel = if (grabstein >= 0) grabstein else i;
                this.items[ziel] = value;
                this.states[ziel] = 1;
                this.count = this.count + 1;
                if (grabstein < 0) {
                    this.used = this.used + 1;
                }
                return true;
            }
            if (this.states[i] == 2) {
                if (grabstein < 0) {
                    grabstein = i;
                }
            } else {
                let vorhanden = this.items[i];
                if (vorhanden != null && vorhanden.equals(value)) {
                    return false;                 // schon da
                }
            }
            i = (i + 1) % n;
        }
    }

    /// Entfernt und liefert `true`, wenn der Wert da war.
    pub mut fn remove(value: T): bool {
        let i = this.findSlot(value);
        if (i < 0) {
            return false;
        }
        this.items[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return true;
    }

    pub fn iter(): Iterator<T> {
        return SetIterator<T> { source = this, index = 0 };
    }

    mut fn resize(capacity: int): void {
        let alteItems = this.items;
        let alteStates = this.states;

        let hole: ?T = null;
        this.items = [hole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        var i = 0;
        while (i < alteStates.length) {
            if (alteStates[i] == 1) {
                let v = alteItems[i];
                if (v != null) {
                    this.add(v);
                }
            }
            i = i + 1;
        }
    }
}

// Laeuft ueber die belegten Slots. Die Reihenfolge haengt an den Hashes und ist damit
// UNSPEZIFIZIERT — wer eine braucht, sortiert.
pub class SetIterator<T :: [Hashable<T>, Equatable<T>]> :: [Iterator<T>] {
    source: Set<T>,
    index: int,

    pub mut fn next(): ?T {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.items[i];
            }
        }
        return null;
    }
}

pub fn emptySet<T :: [Hashable<T>, Equatable<T>]>(): Set<T> {
    let hole: ?T = null;
    return Set<T> { items = [hole] * 8, states = [0] * 8, count = 0, used = 0 };
}

// --- Mengenoperationen. Alle liefern eine NEUE Menge; keine aendert ihre Argumente. ---

pub fn union<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = emptySet<T>();
    for (v in a.iter()) { result.add(v); }
    for (v in b.iter()) { result.add(v); }
    return result;
}

pub fn intersect<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = emptySet<T>();
    // Ueber die KLEINERE laufen: die Anzahl der Sondierungen haengt daran, und bei sehr
    // ungleichen Groessen ist das der Unterschied zwischen linear und quadratisch-gefuehlt.
    let klein = if (a.length() <= b.length()) a else b;
    let gross = if (a.length() <= b.length()) b else a;
    for (v in klein.iter()) {
        if (gross.contains(v)) { result.add(v); }
    }
    return result;
}

pub fn difference<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = emptySet<T>();
    for (v in a.iter()) {
        if (!b.contains(v)) { result.add(v); }
    }
    return result;
}

pub fn isSubset<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): bool {
    if (a.length() > b.length()) {
        return false;
    }
    for (v in a.iter()) {
        if (!b.contains(v)) { return false; }
    }
    return true;
}

// ------------------------------------------------- Map durchlaufen (M8b/S4, Nachtrag)
//
// Ohne diese drei war eine `Map` **nicht durchlaufbar** — man konnte etwas hineinlegen und gezielt
// herausholen, aber nicht wissen, was drin ist. Sie fehlten, weil `Set.iter()` am selben
// Compiler-Fehler haengenblieb (`Iterator<T>` als Rueckgabetyp einer Methode auf einer Instanz mit
// constraintem Typ-Parameter); mit dem Fix gehen sie.
//
// **`entries(): Iterator<(K, V)>` fehlt weiterhin** — ein Tupel als Typargument eines generischen
// Interfaces ist nicht lowerbar. Derselbe offene Punkt, der `zip` und `enumerate` in `std.iter`
// blockiert.
//
// Die Reihenfolge haengt an den Hashes und ist damit UNSPEZIFIZIERT. Wer eine braucht, sammelt und
// sortiert — und dass das ausdruecklich hier steht, ist der Unterschied zwischen einer Zusage und
// einem Zufall, auf den sich jemand verlaesst.

pub class MapKeyIterator<K :: [Hashable<K>, Equatable<K>], V> :: [Iterator<K>] {
    source: Map<K, V>,
    index: int,

    pub mut fn next(): ?K {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.keys[i];
            }
        }
        return null;
    }
}

pub class MapValueIterator<K :: [Hashable<K>, Equatable<K>], V> :: [Iterator<V>] {
    source: Map<K, V>,
    index: int,

    pub mut fn next(): ?V {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.values[i];
            }
        }
        return null;
    }
}

pub fn keys<K :: [Hashable<K>, Equatable<K>], V>(m: Map<K, V>): Iterator<K> {
    return MapKeyIterator<K, V> { source = m, index = 0 };
}

pub fn values<K :: [Hashable<K>, Equatable<K>], V>(m: Map<K, V>): Iterator<V> {
    return MapValueIterator<K, V> { source = m, index = 0 };
}

// ------------------------------------------------------- List durchsuchen (M8b/S4)
//
// Freie Funktionen und keine Methoden: sie brauchen `Equatable<T>`, und diesen Constraint auf die
// KLASSE zu setzen wuerde `List<T>` fuer jeden Typ ohne Gleichheit unbrauchbar machen — auch dort,
// wo niemand sucht. Ein Constraint gehoert an die Stelle, die ihn braucht.

pub fn listContains<T :: [Equatable<T>]>(xs: List<T>, value: T): bool {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Die Position des ersten Vorkommens — `null`, wenn es keines gibt.
pub fn listIndexOf<T :: [Equatable<T>]>(xs: List<T>, value: T): ?int {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return i;
        }
        i = i + 1;
    }
    return null;
}
