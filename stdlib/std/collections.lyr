// std.collections — growing containers.
//
// A `T[]` is a real array with a fixed length. What grows lives here.

module std.collections;

import std.iter { Iterator, Iterable };
import std.core { Hashable, Equatable, Ordered, Deprecated };

/// What can be read and written with `[i]`.
///
/// The same model as `Iterator<T>` for `for-in`: the compiler knows one built-in form — the array —
/// and binds everything else to an interface from the standard library, so there is no special case
/// per container type.
///
/// `get` and `set` are O(1). That is a requirement, not a description: an implementation with O(n)
/// access must not satisfy this interface, or an index loop would be quadratic without showing it.
/// `string` has no index operator for the same reason.
pub interface Indexable<T> {
    /// The value at `index`.
    fn get(index: int): T;
    /// Replaces the value at `index`.
    mut fn set(index: int, value: T): void;
}

/// A growing list; a `T[]` has a fixed length, this does not.
///
/// Growing doubles and shrinking halves at a quarter, so `push` is amortized O(1) and a list
/// oscillating around a boundary does not copy on every step.
// Written in Lyric rather than native. Natives are registered monomorphically, so a generic one
// would need a marshalling layer of its own.
//
// The backing is `(?T)[]` rather than `T[]`, because a slot must be emptiable: `pop` releases its
// value instead of merely hiding it behind `count`, which would keep every inserted object alive.
// It also solves creation: a `T[]` of length n needs n values of type T, and there is no
// `default(T)`; for `?T` there is one.
//
// Growing doubles, shrinking halves at a quarter. Doubling makes `push` amortized O(1); exact
// growth would be O(n) per call. The shrink threshold is a quarter rather than a half so a list
// oscillating around the boundary does not copy on every `push`/`pop`.
pub class List<T> :: [Indexable<T>, Iterable<T>] {
    /// The backing slots; optional so a popped slot can actually release its value.
    data: (?T)[],
    /// How many slots are filled.
    count: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// An empty list.
    pub static fn empty(): List<T> {
        let hole: ?T = null;
        return List<T> { data = [hole] * 0, count = 0 };
    }

    /// A fresh cursor on every call, so two loops over the same list do not disturb each other.
    pub fn iter(): Iterator<T> {
        return ListIterator<T> { source = this, index = 0 };
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// How many slots are allocated, empty ones included. For tests and for anyone measuring what
    /// the list costs; `length` is the truth for everything else.
    pub fn capacity(): int {
        return this.data.length;
    }

    mut fn resize(target: int): void {
        let hole: ?T = null;
        let moved = [hole] * target;

        var i = 0;
        while (i < this.count) {
            moved[i] = this.data[i];
            i = i + 1;
        }
        this.data = moved;
    }

    /// Appends at the end; amortized O(1).
    pub mut fn push(value: T): void {
        if (this.count >= this.data.length) {
            if (this.data.length == 0) {
                this.resize(4);
            } else {
                this.resize(this.data.length * 2);
            }
        }
        this.data[this.count] = value;
        this.count = this.count + 1;
    }

    /// Removes and returns the last value, or `null` for an empty list — an ordinary state,
    /// unlike an index out of range.
    // The slot is cleared rather than skipped, or the list would keep the object alive and a
    // `get` there would read it back.
    pub mut fn pop(): ?T {
        if (this.count == 0) {
            return null;
        }

        this.count = this.count - 1;
        let value = this.data[this.count];
        this.data[this.count] = null;

        // Below a quarter: halve. Four slots always remain; below that the copying does not pay.
        if (this.data.length > 4 && this.count * 4 < this.data.length) {
            this.resize(this.data.length / 2);
        }
        return value;
    }

    /// The value at `index`. Out of range is a panic, as for an array: a programming error
    /// rather than a state.
    pub fn get(index: int): T {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        // Cannot fail: within `count` there is always a value, proven by the check above.
        return this.data[index]!;
    }

    /// Replaces the value at `index`. Out of range is a panic, as in `get`.
    pub mut fn set(index: int, value: T): void {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        this.data[index] = value;
    }

    /// Empties the list. Every slot is released — nothing inserted stays alive — but the
    /// backing array is KEPT: a buffer emptied once per frame must not reallocate on every
    /// refill.
    pub mut fn clear(): void {
        var i = 0;
        while (i < this.count) {
            this.data[i] = null;
            i = i + 1;
        }
        this.count = 0;
    }

    /// A copy as a real array.
    // The return type is `T[]` rather than `?T[]`: within `count` every slot is filled.
    //
    // Built as a `T[]` from the start. There is no reinterpretation of a `?T[]`: `!` unwraps a
    // single value, not an array elementwise, and `?T[]` is an array of optionals. The initial fill
    // therefore needs a real `T`, which the first element provides; the empty list has none and is
    // caught before.
    pub fn toArray(): T[] {
        if (this.count == 0) {
            return [];
        }

        // Cannot fail: `count > 0` means slot 0 is filled, the same assurance as in `get`.
        let first = this.data[0]!;
        let result = [first] * this.count;

        var i = 1;
        while (i < this.count) {
            result[i] = this.data[i]!;
            i = i + 1;
        }
        return result;
    }
}

/// An empty list.
@Deprecated { message = "use List.empty()" }
pub fn emptyList<T>(): List<T> {
    return List<T>.empty();
}

/// Walks a list; each loop holds its own cursor.
pub class ListIterator<T> :: [Iterator<T>] {
    /// The list being walked.
    source: List<T>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?T {
        if (this.index >= this.source.length()) {
            return null;
        }
        let value = this.source.get(this.index);
        this.index = this.index + 1;
        return value;
    }
}

/// Collects an iterator into a `List<T>`.
///
/// Here rather than in `std.iter`, because the dependency runs this way: `std.collections` imports
/// `std.iter`, not the reverse. `std.iter.collectArray` is the variant without that dependency,
/// and it is quadratic because a `T[]` copies on every append. This one doubles and is linear.
pub fn collect<T>(source: Iterator<T>): List<T> {
    var result = List<T>.empty();
    var value = source.next();
    while (value != null) {
        result.push(value);
        value = source.next();
    }
    return result;
}

// ============================================================== Map<K, V>
//
// Open addressing with linear probing: one flat array per column rather than a bucket per slot, and
// a collision moves to the next index. A chain per bucket would need an object and a pointer per
// entry.
//
// Three states per slot (`states`): 0 empty, 1 occupied, 2 deleted. The third is needed because a
// deleted slot must not break the probe chain, or a `get` would stop finding a key behind the gap.
// A tombstone does not end a read but is reusable on a write.
//
// **Load factor 3/4**, measured over occupied AND deleted slots: tombstones cost search time like
// occupied slots, so they have to count. They disappear on a grow.

/// A hash map: open addressing, linear probing, load factor 3/4. The key type says how to
/// hash and how to compare — `[Hashable<K>, Equatable<K>]` — and the iteration order is
/// UNSPECIFIED.
pub class Map<K :: [Hashable<K>, Equatable<K>], V> {
    /// The key column; `states` says which slots are real.
    keys: (?K)[],
    /// The value column, parallel to `keys`.
    values: (?V)[],
    /// Per slot: 0 empty, 1 occupied, 2 tombstone.
    states: int[],
    /// The occupied slots alone.
    count: int,
    /// Occupied plus tombstones — what the load factor is measured over.
    used: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    // The starting index for a key. A hash may be negative, and `%` follows the sign of the
    // dividend.
    fn slotOf(key: K): int {
        let h = key.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.keys.length;
    }

    // Finds the slot of a key, or -1. The loop terminates: the load factor keeps at least a
    // quarter of the slots empty, and an empty slot ends the search.
    fn findSlot(key: K): int {
        var i = this.slotOf(key);
        let n = this.keys.length;
        var steps = 0;

        while (steps < n) {
            if (this.states[i] == 0) {
                return -1; // empty: this is where it would have been
            }
            if (this.states[i] == 1) {
                let present = this.keys[i];
                if (present != null && present.equals(key)) {
                    return i;
                }
            }
            // Tombstone (2): keep going, the chain has not ended.
            i = (i + 1) % n;
            steps = steps + 1;
        }
        return -1;
    }

    /// An empty map, with room for the first insertions before a growth.
    pub static fn empty(): Map<K, V> {
        let keyHole: ?K = null;
        let valueHole: ?V = null;
        return Map<K, V> {
            keys = [keyHole] * 8,
            values = [valueHole] * 8,
            states = [0] * 8,
            count = 0,
            used = 0,
        };
    }

    /// Whether the key is in the map.
    pub fn containsKey(key: K): bool {
        return this.findSlot(key) >= 0;
    }

    /// The value for the key, or `null` when the key is absent.
    pub fn get(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        return this.values[i];
    }

    /// Inserts, or overwrites the existing entry for an equal key.
    pub mut fn set(key: K, value: V): void {
        if ((this.used + 1) * 4 > this.keys.length * 3) {
            this.resize(this.keys.length * 2);
        }

        var i = this.slotOf(key);
        let n = this.keys.length;
        var tombstone = -1;

        while (true) {
            if (this.states[i] == 0) {
                // First free slot. A tombstone seen earlier is preferable: it shortens future
                // searches and does not raise `used`.
                let target = if (tombstone >= 0) tombstone else i;
                this.keys[target] = key;
                this.values[target] = value;
                this.states[target] = 1;
                this.count = this.count + 1;
                if (tombstone < 0) {
                    this.used = this.used + 1;
                }
                return;
            }
            if (this.states[i] == 2) {
                if (tombstone < 0) {
                    tombstone = i;
                }
            } else {
                let present = this.keys[i];
                if (present != null && present.equals(key)) {
                    this.values[i] = value; // overwrite, not a new entry
                    return;
                }
            }
            i = (i + 1) % n;
        }
    }

    /// Removes and returns the old value, or `null` when the key was absent.
    // The slot becomes a tombstone rather than empty, which would break the probe chain and
    // hide a key behind it.
    pub mut fn remove(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        let old = this.values[i];
        this.keys[i] = null;
        this.values[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return old;
    }

    mut fn resize(capacity: int): void {
        let oldKeys = this.keys;
        let oldValues = this.values;
        let oldStates = this.states;

        let keyHole: ?K = null;
        let valueHole: ?V = null;
        this.keys = [keyHole] * capacity;
        this.values = [valueHole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        // Reinsert rather than copy: the slots depend on the capacity, and tombstones disappear
        // in the process.
        var i = 0;
        while (i < oldStates.length) {
            if (oldStates[i] == 1) {
                let k = oldKeys[i];
                let v = oldValues[i];
                if (k != null && v != null) {
                    this.set(k, v);
                }
            }
            i = i + 1;
        }
    }
}

/// An empty map.
@Deprecated { message = "use Map.empty()" }
pub fn emptyMap<K :: [Hashable<K>, Equatable<K>], V>(): Map<K, V> {
    return Map<K, V>.empty();
}

// ================================================================ sorting
//
// **Bottom-up Merge Sort**, in Lyric.
//
// Merge sort rather than quicksort: it is STABLE — equal elements keep their order — and O(n log n)
// in the worst case too. Quicksort is unstable and quadratic on already sorted input.
//
// Bottom-up rather than recursive: the loop structure is visible — width 1, 2, 4, … — and adjacent
// runs are merged in each round. There is no call stack whose depth follows the input size.
//
// The cost is a buffer the size of the list.
//
// Two names rather than one, because there is no overloading: `sortList` by the natural order,
// `sortListBy` with a comparison of your own.

/// Sorts in place by the natural order of the type.
pub fn sortList<T :: [Ordered<T>]>(xs: List<T>): void {
    sortListBy<T>(xs, (a: T, b: T) => a.compare(b) < 0);
}

/// Sorts in place with a comparison of your own.
///
/// `less(a, b)` must return `true` when `a` comes STRICTLY before `b`. A `less` returning `true`
/// for equal elements destroys stability; a contradictory `less` makes the output arbitrary but
/// crashes nothing, because the algorithm only compares.
pub fn sortListBy<T>(xs: List<T>, less: fn(T, T) -> bool): void {
    let n = xs.length();
    if (n < 2) {
        return;
    }

    let hole: ?T = null;
    var buffer = [hole] * n;

    var width = 1;
    while (width < n) {
        var start = 0;
        while (start < n) {
            // Two adjacent, already sorted runs: [start, middle) and [middle, end).
            let middle = min(start + width, n);
            let end = min(start + width * 2, n);
            mergeRuns<T>(xs, buffer, start, middle, end, less);
            start = start + width * 2;
        }

        // Written back after every round. Swapping the roles of source and buffer would save
        // half the copies but requires knowing at the end which of the two holds the result.
        var i = 0;
        while (i < n) {
            let v = buffer[i];
            if (v != null) {
                xs.set(i, v);
            }
            i = i + 1;
        }

        width = width * 2;
    }
}

// Merges [start, middle) and [middle, end) from `xs` into `buffer`.
fn mergeRuns<T>(
    xs: List<T>,
    buffer: (?T)[],
    start: int,
    middle: int,
    end: int,
    less: fn(T, T) -> bool
): void {
    var left = start;
    var right = middle;
    var target = start;

    while (left < middle && right < end) {
        let a = xs.get(left);
        let b = xs.get(right);

        // `less(b, a)` rather than `less(a, b)`: on a tie the result is `false`, so the LEFT
        // side wins, and the left side is what came earlier. Stability hangs on this.
        let p = less;
        if (p(b, a)) {
            buffer[target] = b;
            right = right + 1;
        } else {
            buffer[target] = a;
            left = left + 1;
        }
        target = target + 1;
    }

    while (left < middle) {
        buffer[target] = xs.get(left);
        left = left + 1;
        target = target + 1;
    }

    while (right < end) {
        buffer[target] = xs.get(right);
        right = right + 1;
        target = target + 1;
    }
}

fn min(a: int, b: int): int {
    return if (a < b) a else b;
}

// ================================================================== Set<T>
//
// The same probing as `Map`, only without the value column.
//
// Not built as a `Map<T, bool>`, which would waste an array and make `add(x)` read as
// `set(x, true)`. The duplicated probing logic is the more honest price.

/// A hash set: the same probing as `Map`, without the value column. Iteration order is
/// UNSPECIFIED.
pub class Set<T :: [Hashable<T>, Equatable<T>]> {
    /// The element column; `states` says which slots are real.
    items: (?T)[],
    /// Per slot: 0 empty, 1 occupied, 2 tombstone.
    states: int[],
    /// The occupied slots alone.
    count: int,
    /// Occupied plus tombstones — what the load factor is measured over.
    used: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    fn slotOf(value: T): int {
        let h = value.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.items.length;
    }

    fn findSlot(value: T): int {
        var i = this.slotOf(value);
        let n = this.items.length;
        var steps = 0;

        while (steps < n) {
            if (this.states[i] == 0) {
                return -1;
            }
            if (this.states[i] == 1) {
                let present = this.items[i];
                if (present != null && present.equals(value)) {
                    return i;
                }
            }
            i = (i + 1) % n;
            steps = steps + 1;
        }
        return -1;
    }

    /// An empty set.
    pub static fn empty(): Set<T> {
        let hole: ?T = null;
        return Set<T> { items = [hole] * 8, states = [0] * 8, count = 0, used = 0 };
    }

    /// Whether the value is in the set.
    pub fn contains(value: T): bool {
        return this.findSlot(value) >= 0;
    }

    /// Adds and returns `true` when the value was NEW.
    ///
    /// The return value saves a preceding `contains`, which would probe twice.
    pub mut fn add(value: T): bool {
        if ((this.used + 1) * 4 > this.items.length * 3) {
            this.resize(this.items.length * 2);
        }

        var i = this.slotOf(value);
        let n = this.items.length;
        var tombstone = -1;

        while (true) {
            if (this.states[i] == 0) {
                let target = if (tombstone >= 0) tombstone else i;
                this.items[target] = value;
                this.states[target] = 1;
                this.count = this.count + 1;
                if (tombstone < 0) {
                    this.used = this.used + 1;
                }
                return true;
            }
            if (this.states[i] == 2) {
                if (tombstone < 0) {
                    tombstone = i;
                }
            } else {
                let present = this.items[i];
                if (present != null && present.equals(value)) {
                    return false; // already present
                }
            }
            i = (i + 1) % n;
        }
    }

    /// Removes and returns `true` when the value was present.
    pub mut fn remove(value: T): bool {
        let i = this.findSlot(value);
        if (i < 0) {
            return false;
        }
        this.items[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return true;
    }

    /// A fresh cursor on every call.
    pub fn iter(): Iterator<T> {
        return SetIterator<T> { source = this, index = 0 };
    }

    mut fn resize(capacity: int): void {
        let oldItems = this.items;
        let oldStates = this.states;

        let hole: ?T = null;
        this.items = [hole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        var i = 0;
        while (i < oldStates.length) {
            if (oldStates[i] == 1) {
                let v = oldItems[i];
                if (v != null) {
                    this.add(v);
                }
            }
            i = i + 1;
        }
    }
}

/// Walks the occupied slots. The order follows the hashes and is therefore UNSPECIFIED; a
/// caller that needs one sorts.
pub class SetIterator<T :: [Hashable<T>, Equatable<T>]> :: [Iterator<T>] {
    /// The set being walked.
    source: Set<T>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?T {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.items[i];
            }
        }
        return null;
    }
}

/// An empty set.
@Deprecated { message = "use Set.empty()" }
pub fn emptySet<T :: [Hashable<T>, Equatable<T>]>(): Set<T> {
    return Set<T>.empty();
}

// --- Set operations. All return a NEW set; none changes its arguments. ---

/// Everything in either set, as a NEW set; neither argument changes.
pub fn union<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    for (v in a.iter()) {
        result.add(v);
    }
    for (v in b.iter()) {
        result.add(v);
    }
    return result;
}

/// Everything in both sets, as a NEW set; neither argument changes.
pub fn intersect<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    // Walk the SMALLER one: the number of probes depends on it.
    let small = if (a.length() <= b.length()) a else b;
    let large = if (a.length() <= b.length()) b else a;
    for (v in small.iter()) {
        if (large.contains(v)) {
            result.add(v);
        }
    }
    return result;
}

/// Everything in `a` that is not in `b`, as a NEW set; neither argument changes.
pub fn difference<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    for (v in a.iter()) {
        if (!b.contains(v)) {
            result.add(v);
        }
    }
    return result;
}

/// Whether every element of `a` is in `b`.
pub fn isSubset<T :: [Hashable<T>, Equatable<T>]>(a: Set<T>, b: Set<T>): bool {
    if (a.length() > b.length()) {
        return false;
    }
    for (v in a.iter()) {
        if (!b.contains(v)) {
            return false;
        }
    }
    return true;
}

// ------------------------------------------------- walking a Map
//
// Without these three a `Map` could not be walked: values went in and came out, but there was no
// way to know what it held.
//
// The order follows the hashes and is therefore UNSPECIFIED. A caller that needs one collects and
// sorts.

/// Walks the keys; the order follows the hashes and is UNSPECIFIED.
pub class MapKeyIterator<K :: [Hashable<K>, Equatable<K>], V> :: [Iterator<K>] {
    /// The map being walked.
    source: Map<K, V>,
    /// The next slot to look at.
    index: int,

    /// The next key, or `null` at the end.
    pub mut fn next(): ?K {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.keys[i];
            }
        }
        return null;
    }
}

/// Walks the values; the order follows the hashes and is UNSPECIFIED.
pub class MapValueIterator<K :: [Hashable<K>, Equatable<K>], V> :: [Iterator<V>] {
    /// The map being walked.
    source: Map<K, V>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?V {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.values[i];
            }
        }
        return null;
    }
}

/// A fresh cursor over the keys.
pub fn keys<K :: [Hashable<K>, Equatable<K>], V>(m: Map<K, V>): Iterator<K> {
    return MapKeyIterator<K, V> { source = m, index = 0 };
}

/// A fresh cursor over the values.
pub fn values<K :: [Hashable<K>, Equatable<K>], V>(m: Map<K, V>): Iterator<V> {
    return MapValueIterator<K, V> { source = m, index = 0 };
}

// ------------------------------------------------------- searching a List
//
// Free functions rather than methods: they need `Equatable<T>`, and putting that constraint on
// the CLASS would make `List<T>` unusable for every type without equality. A constraint belongs
// where it is needed.

/// Whether the value occurs, by `equals`; O(n).
pub fn listContains<T :: [Equatable<T>]>(xs: List<T>, value: T): bool {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The position of the first occurrence, or `null` when there is none.
pub fn listIndexOf<T :: [Equatable<T>]>(xs: List<T>, value: T): ?int {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return i;
        }
        i = i + 1;
    }
    return null;
}
