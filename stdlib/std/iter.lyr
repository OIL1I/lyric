// std.iter — was 'for-in' antreibt (Sprache.md §5).
//
// Ein Iterator liefert Werte, bis keiner mehr da ist: 'next()' gibt '?T' zurueck, und 'null' heisst
// Ende. Das ist die gesamte Schnittstelle — kein 'hasNext' daneben, das ein zweites Mal dieselbe
// Frage stellt und dabei mit 'next' aus dem Tritt geraten kann.
//
// 'for (x in e)' braucht einen Ausdruck, der 'Iterator<T>' erfuellt. Fuer die drei eingebauten
// Formen — Range, Array, String — hat der Compiler keine Deklaration, an die er eine
// Konformanz haengen koennte; er baut deshalb einen der Adapter hier unten. Ein eigener Typ, der
// 'Iterator<T>' implementiert, wird direkt benutzt.

module std.iter;

// Fuer 'minValue'/'maxValue'. Kein Zyklus: 'std.core' importiert nur 'std.string', und das
// importiert nichts.
import std.core { Ordered };

pub interface Iterator<T> {
    // 'mut', weil ein Iterator seinen Fortschritt fortschreibt — genau das unterscheidet ihn von
    // einer Funktion, die jedes Mal dasselbe liefert.
    mut fn next(): ?T;
}

// Ein Zahlenbereich: 'a..b' (exklusiv) und 'a..=b' (inklusiv) unterscheiden sich allein im
// Endwert, den der Compiler beim Bauen einsetzt — deshalb gibt es hier nur EINEN Adapter und
// nicht zwei.
pub class RangeIterator :: [Iterator<int>] {
    current: int,
    end: int,

    pub mut fn next(): ?int {
        if (this.current >= this.end) {
            return null;
        }
        let value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

// Ein Array. Der Index gehoert dem Iterator und nicht dem Array — zwei Schleifen ueber dasselbe
// Array stoeren einander deshalb nicht.
pub class ArrayIterator<T> :: [Iterator<T>] {
    source: T[],
    index: int,

    pub mut fn next(): ?T {
        if (this.index >= this.source.length) {
            return null;
        }
        let value = this.source[this.index];
        this.index = this.index + 1;
        return value;
    }
}

// Ein String. Er laeuft ueber die Codepoints, die 'toChars' EINMAL herausloest — nicht ueber
// 'charAt', das pro Aufruf von vorn zaehlen muesste und die Schleife quadratisch machte.
// Der Preis ist ein Array pro Schleife; der Gewinn ist, dass 'for (c in s)' linear bleibt.
pub class StringIterator :: [Iterator<char>] {
    chars: char[],
    index: int,

    pub mut fn next(): ?char {
        if (this.index >= this.chars.length) {
            return null;
        }
        let value = this.chars[this.index];
        this.index = this.index + 1;
        return value;
    }
}

// Was sich durchlaufen laesst.
//
// Die Zweiteilung ist Absicht und folgt C# (Iterable/Iterator), Java und Rust: ein Container
// SAGT, wie man ihn durchlaeuft, statt selbst der Cursor zu sein. Waere 'List<T>' ihr eigener
// 'Iterator<T>', haette sie einen eingebauten Fortschritt — und zwei Schleifen ueber dieselbe
// Liste wuerden einander weiterschieben. Aus demselben Grund haelt 'ArrayIterator' den Index und
// nicht das Array.
//
// 'for (x in e)' fragt damit VORWAERTS: erfuellt 'e' dieses Interface, wird 'iter()' gerufen. Der
// Compiler sucht nicht rueckwaerts nach einem Iterator, der 'e' als Quelle nimmt — das waere bei
// zwei Kandidaten mehrdeutig und muesste alle sichtbaren Module absuchen.
//
// Die drei eingebauten Formen — Range, Array, String — sind die begruendete Ausnahme: sie haben
// keine Deklaration, an die sich eine Konformanz haengen liesse, also baut der Compiler ihren
// Adapter selbst.
pub interface Iterable<T> {
    fn iter(): Iterator<T>;
}

// ====================================================================== Adapter (M8b/S3)
//
// Jeder Adapter ist eine Klasse mit Zustand plus eine Funktion, die sie baut. Die Funktion gibt
// `Iterator<T>` zurueck und nicht die Klasse: so laesst sich verketten, ohne dass der Typ des
// Zwischenergebnisses im Quelltext auftaucht.
//
// **Faul, nicht eifrig.** Kein Adapter zieht seine Quelle leer, bevor jemand `next` ruft. Wer
// `take(map(riesig, teuer), 3)` schreibt, bezahlt drei Aufrufe von `teuer` und nicht Millionen —
// das ist der Grund, warum es Iteratoren gibt und nicht nur Arrays.
//
// Die Adapter halten ihre Quelle als `Iterator<T>`, also als Fat Pointer (P3). Das kostet einen
// virtuellen Aufruf je Element; die Alternative waere ein zweiter Typ-Parameter je Adapter, und
// der wuerde jede Signatur verdoppeln.

pub class MapIterator<T, U> :: [Iterator<U>] {
    source: Iterator<T>,
    f: fn(T) -> U,

    pub mut fn next(): ?U {
        let value = this.source.next();
        if (value == null) {
            return null;
        }
        let g = this.f;
        return g(value);
    }
}

pub fn map<T, U>(source: Iterator<T>, f: fn(T) -> U): Iterator<U> {
    return MapIterator<T, U> { source = source, f = f };
}

pub class FilterIterator<T> :: [Iterator<T>] {
    source: Iterator<T>,
    keep: fn(T) -> bool,

    pub mut fn next(): ?T {
        var value = this.source.next();
        while (value != null) {
            let p = this.keep;
            if (p(value)) {
                return value;
            }
            value = this.source.next();
        }
        return null;
    }
}

pub fn filter<T>(source: Iterator<T>, keep: fn(T) -> bool): Iterator<T> {
    return FilterIterator<T> { source = source, keep = keep };
}

pub class TakeIterator<T> :: [Iterator<T>] {
    source: Iterator<T>,
    remaining: int,

    pub mut fn next(): ?T {
        if (this.remaining <= 0) {
            return null;
        }
        this.remaining = this.remaining - 1;
        return this.source.next();
    }
}

// Die ersten `count` Elemente. Ein negatives `count` liefert nichts, statt zu panicen: „nimm
// minus drei" ist keine gebrochene Zusage, sondern eine leere Auswahl.
pub fn take<T>(source: Iterator<T>, count: int): Iterator<T> {
    return TakeIterator<T> { source = source, remaining = count };
}

pub class SkipIterator<T> :: [Iterator<T>] {
    source: Iterator<T>,
    pending: int,

    pub mut fn next(): ?T {
        // Erst beim ersten `next` ueberspringen, nicht beim Bauen — sonst waere der Adapter
        // eifrig und `skip` allein haette schon einen Effekt.
        while (this.pending > 0) {
            this.pending = this.pending - 1;
            if (this.source.next() == null) {
                return null;
            }
        }
        return this.source.next();
    }
}

pub fn skip<T>(source: Iterator<T>, count: int): Iterator<T> {
    return SkipIterator<T> { source = source, pending = count };
}

pub class TakeWhileIterator<T> :: [Iterator<T>] {
    source: Iterator<T>,
    keep: fn(T) -> bool,
    done: bool = false,

    pub mut fn next(): ?T {
        if (this.done) {
            return null;
        }
        let value = this.source.next();
        if (value == null) {
            this.done = true;
            return null;
        }
        let p = this.keep;
        if (p(value)) {
            return value;
        }
        // Nach dem ersten `false` ist Schluss — auch wenn spaeter wieder `true` kaeme. Das
        // unterscheidet `takeWhile` von `filter`, und es ist der ganze Zweck.
        this.done = true;
        return null;
    }
}

pub fn takeWhile<T>(source: Iterator<T>, keep: fn(T) -> bool): Iterator<T> {
    return TakeWhileIterator<T> { source = source, keep = keep };
}

pub class EnumerateIterator<T> :: [Iterator<(int, T)>] {
    source: Iterator<T>,
    index: int = 0,

    pub mut fn next(): ?(int, T) {
        let value = this.source.next();
        if (value == null) {
            return null;
        }
        let position = this.index;
        this.index = this.index + 1;
        return (position, value);
    }
}

/// Nummeriert durch: aus `a, b, c` wird `(0, a), (1, b), (2, c)`.
pub fn enumerate<T>(source: Iterator<T>): Iterator<(int, T)> {
    return EnumerateIterator<T> { source = source };
}

pub class ZipIterator<A, B> :: [Iterator<(A, B)>] {
    left: Iterator<A>,
    right: Iterator<B>,

    pub mut fn next(): ?(A, B) {
        let a = this.left.next();
        if (a == null) {
            return null;
        }
        let b = this.right.next();
        if (b == null) {
            return null;
        }
        return (a, b);
    }
}

/// Laeuft parallel ueber beide und endet mit dem KUERZEREN.
///
/// Der eine ueberzaehlige Aufruf auf `left` ist der Preis dafuer, dass beide Seiten dieselbe
/// Schnittstelle haben: um ihn zu sparen, braeuchte `Iterator<T>` ein `peek`, und das gaebe es
/// sonst nirgends.
pub fn zip<A, B>(left: Iterator<A>, right: Iterator<B>): Iterator<(A, B)> {
    return ZipIterator<A, B> { left = left, right = right };
}

pub class ChainIterator<T> :: [Iterator<T>] {
    first: Iterator<T>,
    second: Iterator<T>,
    onFirst: bool = true,

    pub mut fn next(): ?T {
        if (this.onFirst) {
            let value = this.first.next();
            if (value != null) {
                return value;
            }
            this.onFirst = false;
        }
        return this.second.next();
    }
}

pub fn chain<T>(first: Iterator<T>, second: Iterator<T>): Iterator<T> {
    return ChainIterator<T> { first = first, second = second };
}

// ================================================================= Terminatoren (M8b/S3)
//
// Ein Terminator zieht den Iterator leer und liefert einen Wert. Damit endet eine Kette — und
// erst hier passiert ueberhaupt etwas: die Adapter darueber sind faul.
//
// Nach einem Terminator ist der Iterator verbraucht. Lyric hat keine Moeglichkeit, das
// auszudruecken (kein Move, kein Borrow-Checker), also ist es eine Zusage an den Leser und keine
// des Compilers: wer denselben Iterator zweimal terminiert, bekommt beim zweiten Mal nichts.

/// Faltet von links: `fold(1..4, 0, (acc, n) => acc + n)` ist `((0+1)+2)+3`.
///
/// Der allgemeinste Terminator — `count`, `sum`, `any` und `all` sind Spezialfaelle davon. Sie
/// stehen trotzdem einzeln da, weil `fold` mit einer Closure fuer „zaehl mal" zu viel Zeremonie
/// ist.
pub fn fold<T, A>(source: Iterator<T>, seed: A, step: fn(A, T) -> A): A {
    var acc = seed;
    var value = source.next();
    while (value != null) {
        let f = step;
        acc = f(acc, value);
        value = source.next();
    }
    return acc;
}

pub fn count<T>(source: Iterator<T>): int {
    var n = 0;
    var value = source.next();
    while (value != null) {
        n = n + 1;
        value = source.next();
    }
    return n;
}

// `sum` und `sumFloat` getrennt, weil Lyric kein Overloading hat (ADR-015) und es kein
// `Addable`-Interface gibt. Ein solches Interface waere die Alternative — es gehoert aber zu
// Operator-Overloading (v1.4) und nicht hierher.
pub fn sum(source: Iterator<int>): int {
    var total = 0;
    var value = source.next();
    while (value != null) {
        total = total + value;
        value = source.next();
    }
    return total;
}

pub fn sumFloat(source: Iterator<float>): float {
    var total = 0.0;
    var value = source.next();
    while (value != null) {
        total = total + value;
        value = source.next();
    }
    return total;
}

/// Bricht beim ersten Treffer ab — der Rest wird nie ausgewertet.
pub fn any<T>(source: Iterator<T>, test: fn(T) -> bool): bool {
    var value = source.next();
    while (value != null) {
        let p = test;
        if (p(value)) {
            return true;
        }
        value = source.next();
    }
    return false;
}

/// Bricht beim ersten Gegenbeispiel ab. Ein leerer Iterator liefert `true` — das ist die
/// uebliche Konvention und die einzige, mit der `all(a) && all(b) == all(chain(a, b))` gilt.
pub fn all<T>(source: Iterator<T>, test: fn(T) -> bool): bool {
    var value = source.next();
    while (value != null) {
        let p = test;
        if (!p(value)) {
            return false;
        }
        value = source.next();
    }
    return true;
}

pub fn none<T>(source: Iterator<T>, test: fn(T) -> bool): bool {
    return !any<T>(source, test);
}

/// Das erste Element, das passt — `null`, wenn keines passt.
pub fn find<T>(source: Iterator<T>, test: fn(T) -> bool): ?T {
    var value = source.next();
    while (value != null) {
        let p = test;
        if (p(value)) {
            return value;
        }
        value = source.next();
    }
    return null;
}

/// Die Position des ersten Treffers. Getrennt von `find`, weil ein Tupel `(int, T)` hier den
/// haeufigen Fall verteuern wuerde, in dem nur eines von beidem gebraucht wird.
pub fn position<T>(source: Iterator<T>, test: fn(T) -> bool): ?int {
    var index = 0;
    var value = source.next();
    while (value != null) {
        let p = test;
        if (p(value)) {
            return index;
        }
        index = index + 1;
        value = source.next();
    }
    return null;
}

/// Alles in ein Array.
///
/// **Quadratisch**: `T[]` ist unveraenderlich in der Laenge (ADR-016), jedes Anhaengen kopiert.
/// Fuer grosse Iteratoren gehoert `std.collections.collect` benutzt, das in eine `List<T>` mit
/// Verdoppelung sammelt. Hier steht es trotzdem, weil `std.iter` `std.collections` nicht
/// importieren darf — die Abhaengigkeit laeuft andersherum.
pub fn collectArray<T>(source: Iterator<T>): T[] {
    var result: T[] = [];
    var value = source.next();
    while (value != null) {
        result = result + [value];
        value = source.next();
    }
    return result;
}

/// Das kleinste Element — `null` bei leerer Quelle.
pub fn minValue<T :: [Ordered<T>]>(source: Iterator<T>): ?T {
    var best = source.next();
    if (best == null) {
        return null;
    }
    var value = source.next();
    while (value != null) {
        if (value.compare(best) < 0) {
            best = value;
        }
        value = source.next();
    }
    return best;
}

pub fn maxValue<T :: [Ordered<T>]>(source: Iterator<T>): ?T {
    var best = source.next();
    if (best == null) {
        return null;
    }
    var value = source.next();
    while (value != null) {
        if (value.compare(best) > 0) {
            best = value;
        }
        value = source.next();
    }
    return best;
}
