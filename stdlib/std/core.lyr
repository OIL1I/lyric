// std.core — was die Sprache selbst braucht.
//
// 'panic' ist ein Sprach-Built-in (Sprache.md §9) mit Rueckgabetyp 'never': es kehrt nie zurueck,
// laesst sich nicht fangen und beendet die VM mit Backtrace. Der Compiler bindet den Aufruf hier
// an, ohne dass jemand 'std.core' importiert — dasselbe Modell wie bei den f-String-Helfern in
// 'std.string'.

module std.core;

// Fuer die Display-Extensions unten. 'std.string' importiert 'std.core' nicht, also ist das
// kein Zyklus — und selbst einer wuerde terminieren (der Lader registriert vor dem Absteigen).
import std.string { fromInt, fromFloat, fromBool, fromChar };

pub fn panic(message: string): void;

// Ein 'resume' auf eine Coroutine, deren Rumpf durchgelaufen ist (Sprache.md §8). Wie 'panic'
// vom Compiler angebunden, ohne dass jemand 'std.core' importiert — der Aufruf steht im
// Sprungverteiler, den niemand geschrieben hat, also kann auch niemand den Import geschrieben
// haben.
pub fn coroutineEnded(): void;

// Display — was sich als Text darstellen laesst (M8/S1).
//
// Der Anker fuer 'println<T :: [Display]>' und fuer 'std.fmt'. Dass ein Builtin ihn erfuellen
// kann, ist der ganze Punkt: die Konformanz haengt an einem 'extend', und der Constraint-Aufruf
// wird durch die Monomorphisierung ein DIREKTER Aufruf. Es entsteht kein Interface-Wert, also
// braucht ein 'int' hier kein Boxing — der Grund, warum das ohne Format-Aenderung geht.
//
// Ein Wert, der ueber sein Interface vorliegt ('let d: Display = 5;'), bleibt verboten: dafuer
// braeuchte der Fat Pointer eine Referenz, und ein Skalar hat keine.
pub interface Display {
    fn show(): string;
}

extend int :: [Display] {
    fn show(): string { return fromInt(this); }
}

extend float :: [Display] {
    fn show(): string { return fromFloat(this); }
}

extend bool :: [Display] {
    fn show(): string { return fromBool(this); }
}

extend char :: [Display] {
    fn show(): string { return fromChar(this); }
}

extend string :: [Display] {
    fn show(): string { return this; }
}
