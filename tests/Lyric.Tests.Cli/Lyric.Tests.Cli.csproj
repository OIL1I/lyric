<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      The three binaries are built but NOT copied here and not referenced as assemblies. These
      tests drive the toolchain as processes, the way a user does. With the assemblies linked, the
      architecture test would check the wrong directory: the question is what lies next to
      'lyrvm.exe' when it ships.
    -->
    <!-- For the diagnostic and exit code constants: the tests check codes, not texts. -->
    <ProjectReference Include="..\..\src\Lyric.Core\Lyric.Core.csproj" />

    <ProjectReference Include="..\..\src\Lyrc\Lyrc.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\Lyrvm\Lyrvm.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\Lyric.Cli\Lyric.Cli.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
