fn main.double -> i64 {
  params: 1
  locals:
    l0 n: i64
  bb0:
    t0: i64 = load l0
    t1: i64 = const 2
    t2: i64 = mul t0, t1
    ret t2
}

fn main.touch -> void {
  params: 1
  locals:
    l0 n: i64
    l1 x: i64
  bb0:
    t0: i64 = load l0
    store l1, t0
    t1: i64 = load l1
    t2: i64 = const 1
    t3: i64 = add t1, t2
    store l1, t3
    ret
}

fn main.fact -> i64 {
  params: 1
  locals:
    l0 n: i64
  bb0:
    t0: i64 = load l0
    t1: i64 = const 1
    t2: bool = le t0, t1
    condbr t2 -> bb1, bb2
  bb1:
    t3: i64 = const 1
    ret t3
  bb2:
    t4: i64 = load l0
    t5: i64 = load l0
    t6: i64 = const 1
    t7: i64 = sub t5, t6
    t8: i64 = call main.fact(t7)
    t9: i64 = mul t4, t8
    ret t9
}

fn main.main -> i64 {
  params: 0
  locals:
  bb0:
    t0: i64 = const 1
    call main.touch(t0)
    t1: i64 = const 4
    t2: i64 = call main.fact(t1)
    t3: i64 = call main.double(t2)
    ret t3
}
