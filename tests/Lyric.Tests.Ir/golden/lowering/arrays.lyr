// Arrays: T[] is a real array whose length is fixed at creation. It is built from the literal, from
// [x] * n and from xs + ys, and all three yield a NEW array.
fn build(n: int): int[] {
    return [0] * n;
}

fn sum(xs: int[]): int {
    var total = 0;
    var i = 0;
    while (i < xs.length) {
        total += xs[i];
        i += 1;
    }
    return total;
}

fn main(): int {
    let xs = [3, 7, 1];
    let zeros = build(2);

    // Element assignment, compound as well: the array and the index are each evaluated once.
    // 'var', because the index operator requires a mutable target, unlike a class field, which is
    // writable through any binding.
    var ys = xs + zeros;
    ys[3] = 10;
    ys[4] += 5;

    return sum(ys);
}
