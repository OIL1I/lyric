fn main.countdown -> i64 {
  params: 1
  locals:
    l0 n: i64
    l1 i: i64
    l2 steps: i64
  bb0:
    t0: i64 = load l0
    store l1, t0
    t1: i64 = const 0
    store l2, t1
    br bb1
  bb1:
    t2: i64 = load l1
    t3: i64 = const 1
    t4: i64 = sub t2, t3
    store l1, t4
    t5: i64 = load l2
    t6: i64 = const 1
    t7: i64 = add t5, t6
    store l2, t7
    br bb2
  bb2:
    t8: i64 = load l1
    t9: i64 = const 0
    t10: bool = gt t8, t9
    condbr t10 -> bb1, bb3
  bb3:
    t11: i64 = load l2
    ret t11
}
