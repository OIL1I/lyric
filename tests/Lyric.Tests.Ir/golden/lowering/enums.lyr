// Enums. Every variant is a type of its own with its own layout; slot 0 is its tag and the payload
// fields follow from slot 1.
//
// 'match' has no instruction of its own: it reads the tag with enumtag and branches over it like any
// other case distinction. After the branch enumas narrows, and a field access on that is an ordinary
// loadfield with the layout of the variant.
enum Shape {
    Circle(int),
    Rect { w: int, h: int },
    Empty;

    fn area(): int {
        return match (this) {
            Circle(r) => r * r * 3,
            Rect { w, h } => w * h,
            Empty => 0,
        };
    }
}

fn main(): int {
    let a = Shape.Circle(2);
    let b: Shape = Shape.Rect { w = 3, h = 4 };
    let c = Shape.Empty;
    return a.area() + b.area() + c.area();
}
