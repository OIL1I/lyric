type ty0 Node {
  #0 payload: i64
  #1 next: &ty0
}
type ty1 Inner {
  #0 value: i64
}
type ty2 Outer {
  #0 inner: &ty1
  #1 count: i64
}

fn main.main -> i64 {
  params: 0
  locals:
    l0 inner: &ty1
    l1 outer: &ty2
  bb0:
    t0: i64 = const 7
    t1: &ty1 = newobj ty1
    storefield t1, ty1#0, t0
    store l0, t1
    t2: &ty1 = load l0
    t3: i64 = const 1
    t4: &ty2 = newobj ty2
    storefield t4, ty2#0, t2
    storefield t4, ty2#1, t3
    store l1, t4
    t5: &ty2 = load l1
    t6: &ty1 = loadfield t5, ty2#0
    t7: i64 = loadfield t6, ty1#0
    ret t7
}
