// Methods: the receiver is parameter 0, exactly as in CIL. The difference between an instance and a
// static method therefore lies in the parameter list alone.
class Counter {
    value: int,

    // A factory: no receiver, hence 'static'. Without the marker it would need an object that does not
    // exist yet at this point.
    static fn new(start: int): Counter {
        return Counter { value = start };
    }

    fn get(): int {
        return this.value;
    }

    fn bump(by: int) {
        this.value += by;
    }

    // Passing this on as an argument: the receiver is an ordinary value.
    fn twice(): int {
        return add(this.get(), this.get());
    }
}

fn add(a: int, b: int): int {
    return a + b;
}

fn main(): int {
    let c = Counter.new(7);
    c.bump(3);
    return c.twice();
}
