fn main.Counter.twice -> i64 {
  params: 1
  locals:
    l0 this: &ty0
  bb0:
    t0: &ty0 = load l0
    t1: i64 = call main.Counter.get(t0)
    t2: &ty0 = load l0
    t3: i64 = call main.Counter.get(t2)
    t4: i64 = call main.add(t1, t3)
    ret t4
}
