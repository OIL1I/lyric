// Optionals. "no value" is an empty reference, uniform for every ?T.
//
// '??' has no instruction of its own: its right-hand side is evaluated only when the left holds
// nothing, so it lowers to branches over optissome, like && and ||.
fn find(x: int): ?int {
    if (x > 0) {
        return x;   // T -> ?T is implicit; the lowerer inserts the optsome
    }
    return null;
}

fn main(): int {
    let a = find(7) ?? 0;
    let forced = find(5)!;      // optget; panics when nothing is there

    var total = a + forced;

    // Flow narrowing: in the then branch 'maybe' has the type int, while the SLOT still holds ?int.
    // The optget on the read redeems exactly that narrowing and can never panic, because the sema has
    // already excluded null.
    let maybe = find(3);
    if (maybe != null) {
        total += maybe;
    }

    return total;
}
