// A field whose type is itself a class, and a RECURSIVE type.
//
// Node is not constructed here: every Node needs a next, and without optionals that chain never ends.
// The TYPE still has to be encodable, and that is what this fixture checks — Node is interned through
// a parameter rather than through a newobj. Structurally the layout would not be finite; through the
// type id it is.
class Node {
    payload: int,
    next: Node
}

class Inner {
    value: int
}

class Outer {
    inner: Inner,
    count: int
}

fn depth(n: Node): int {
    return n.next.payload;
}

fn main(): int {
    let inner = Inner { value = 7 };
    let outer = Outer { inner = inner, count = 1 };
    return outer.inner.value;
}
