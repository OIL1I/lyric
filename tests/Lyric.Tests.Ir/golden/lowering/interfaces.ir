interface ty0 Sized {
  #0 size
  #1 doubled
}
type ty1 Small {
  #0 n: i64
}
type ty2 Big {
  #0 n: i64
}
impl ty1 :: ty0 [f3, f2]
impl ty2 :: ty0 [f4, f5]

fn main.measure -> i64 {
  params: 1
  locals:
    l0 s: dyn ty0
  bb0:
    t0: dyn ty0 = load l0
    t1: i64 = callvirt ty0#0(t0)
    t2: dyn ty0 = load l0
    t3: i64 = callvirt ty0#1(t2)
    t4: i64 = add t1, t3
    ret t4
}

fn main.main -> i64 {
  params: 0
  locals:
  bb0:
    t0: i64 = const 3
    t1: &ty1 = newobj ty1
    storefield t1, ty1#0, t0
    t2: dyn ty0 = mkiface t1, ty1
    t3: i64 = call main.measure(t2)
    t4: i64 = const 7
    t5: &ty2 = newobj ty2
    storefield t5, ty2#0, t4
    t6: dyn ty0 = mkiface t5, ty2
    t7: i64 = call main.measure(t6)
    t8: i64 = add t3, t7
    ret t8
}

fn main.Sized.doubled -> i64 {
  params: 1
  locals:
    l0 this: dyn ty0
  bb0:
    t0: dyn ty0 = load l0
    t1: i64 = callvirt ty0#0(t0)
    t2: i64 = const 2
    t3: i64 = mul t1, t2
    ret t3
}

fn main.Small.size -> i64 {
  params: 1
  locals:
    l0 this: &ty1
  bb0:
    t0: &ty1 = load l0
    t1: i64 = loadfield t0, ty1#0
    ret t1
}

fn main.Big.size -> i64 {
  params: 1
  locals:
    l0 this: &ty2
  bb0:
    t0: &ty2 = load l0
    t1: i64 = loadfield t0, ty2#0
    t2: i64 = const 100
    t3: i64 = mul t1, t2
    ret t3
}

fn main.Big.doubled -> i64 {
  params: 1
  locals:
    l0 this: &ty2
  bb0:
    t0: i64 = const 0
    ret t0
}
