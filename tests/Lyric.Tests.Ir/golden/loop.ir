fn main.sumTo -> i64 {
  params: 1
  locals:
    l0 n: i64
    l1 i: i64
    l2 acc: i64
  bb0:
    t0: i64 = const 0
    store l2, t0
    t1: i64 = const 0
    store l1, t1
    br bb1
  bb1:
    t2: i64 = load l1
    t3: i64 = load l0
    t4: bool = lt t2, t3
    condbr t4 -> bb2, bb3
  bb2:
    t5: i64 = load l2
    t6: i64 = load l1
    t7: i64 = add t5, t6
    store l2, t7
    t8: i64 = load l1
    t9: i64 = const 1
    t10: i64 = add t8, t9
    store l1, t10
    br bb1
  bb3:
    t11: i64 = load l2
    ret t11
}
