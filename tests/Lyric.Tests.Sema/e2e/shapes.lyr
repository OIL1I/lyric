// shapes.lyr — Komplexität: mittel
// Zeigt: enum mit Tuple-/Struct-Varianten und Methoden, match als Ausdruck,
// Block-Arme, kontextuelle Varianten-Konstruktion, Array von Enum-Werten.

import std.io.console { println };
import std.math { sqrt, pi };

pub enum Shape {
    Circle(float),
    Rectangle(float, float),
    Triangle { a: float, b: float, c: float },
    Empty;

    fn area(): float {
        return match (this) {
            Circle(r)       => pi * r * r,
            Rectangle(w, h) => w * h,
            Triangle { a, b, c } => {
                let s = (a + b + c) / 2.0;
                return sqrt(s * (s - a) * (s - b) * (s - c));
            },
            Empty => 0.0,
        };
    }

    fn name(): string {
        return match (this) {
            Circle(_)            => "Kreis",
            Rectangle(_, _)      => "Rechteck",
            Triangle { a, b, c } => "Dreieck",
            Empty                => "Leer",
        };
    }
}

fn main(): int {
    let shapes: Shape[] = [
        Shape.Circle(2.0),
        Shape.Rectangle(3.0, 4.0),
        Triangle { a = 3.0, b = 4.0, c = 5.0 },   // Typ kontextuell aus Shape[]
        Shape.Empty,
    ];

    for (s in shapes) {
        println(f"{s.name()}: Flaeche = {s.area():N2}");
    }
    return 0;
}
