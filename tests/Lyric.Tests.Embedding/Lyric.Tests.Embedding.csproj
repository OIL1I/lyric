<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!--
      The embedding assembly only, not the frontend and the runtime separately. The question of
      this project is what a FOREIGN host sees, and that is lyrembed. With lyrfe and lyrrt
      referenced directly, a test could reach past the surface and stay green although the surface
      itself does not answer the question.
    -->
    <ProjectReference Include="..\..\src\Lyric.Embedding\Lyric.Embedding.csproj" />

    <!--
      The example host is BUILT but not referenced: the gate test runs it as a process, the same
      decision as in Lyric.Tests.Cli. The question is what a foreign consumer sees, and in-process
      would not answer that honestly.
    -->
    <ProjectReference Include="..\..\examples\embedded-host\EmbeddedHost.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
