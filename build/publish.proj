<!--
  DefaultTargets is written out rather than left to "the first target wins": inserting a target
  above the publish would otherwise silently turn the file into something else.
-->
<Project DefaultTargets="Publish">

  <!--
    The shipping layout: five binaries, five libraries and the standard library in ONE directory.

        dotnet msbuild build/publish.proj
        dotnet msbuild build/publish.proj -p:PublishRoot=D:\somewhere
        dotnet msbuild build/publish.proj -p:Rid=linux-x64        (a shipping build)

    An MSBuild project rather than a publish.ps1: a script would be a second build language beside
    the one that already runs, and it would have to know the configuration (Release, framework,
    project paths) a second time.

    Not 'dotnet publish Lyric.slnx -o ...': the SDK rejects a shared output directory for a whole
    solution (NETSDK1194), because with colliding file names the result would depend on the build
    order. Here the overlap is wanted and controlled — the binaries SHARE lyrcore/lyrfe/lyrrt, which
    is the whole point of a common folder.
  -->

  <PropertyGroup>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishRoot>
    <PublishRoot>$([System.IO.Path]::GetFullPath('$(PublishRoot)'))</PublishRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

    <!--
      A runtime identifier turns the output into a build FOR one platform. Without one the result is
      portable and needs a .NET runtime on the target machine; with one plus SelfContained it brings
      its own and runs straight out of the archive.

      Empty by default, so a local run stays the small, quick framework-dependent build a developer
      wants. A release passes it, and the archive then really holds what its name says — the release
      matrix used to label three archives with platforms the publish never heard of.
    -->
    <Rid Condition="'$(Rid)' == ''"></Rid>
    <SelfContained Condition="'$(SelfContained)' == '' and '$(Rid)' != ''">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>


    <!-- Handed to every project below. With no Rid this is just the configuration, as before. -->
    <PublishProperties>Configuration=$(Configuration)</PublishProperties>
    <PublishProperties Condition="'$(Rid)' != ''">$(PublishProperties);RuntimeIdentifier=$(Rid);SelfContained=$(SelfContained)</PublishProperties>

    <!--
      The stub lyrpack packs with. Unlike the binaries above it never runs from this directory —
      it is a TEMPLATE, one file, under stubs/<rid>/ where lyrpack resolves it. A shipping build
      makes it self-contained like everything else in the archive; a local run keeps it
      framework-dependent for the SDK's own platform, so 'lyric pack' works out of a local
      publish too.
    -->
    <!--
      The host's RID comes from the runtime MSBuild itself runs on, NOT from
      $(NETCoreSdkPortableRuntimeIdentifier): that is an SDK property, and this file is not an
      SDK project — it evaluated to empty here, and a single-file publish without a
      RuntimeIdentifier is NETSDK1097. The release never saw it because a shipping build passes
      -p:Rid; every CI publish without one failed.
    -->
    <StubRid Condition="'$(Rid)' != ''">$(Rid)</StubRid>
    <StubRid Condition="'$(Rid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</StubRid>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The order does not matter, but the builds must NOT run in parallel: five publishes into the
      same directory that share lyrcore.dll would overwrite the file under each other's hands.
    -->
    <Binary Include="..\src\Lyric.Cli\Lyric.Cli.csproj" />
    <Binary Include="..\src\Lyrc\Lyrc.csproj" />
    <Binary Include="..\src\Lyrvm\Lyrvm.csproj" />
    <Binary Include="..\src\Lyrrepl\Lyrrepl.csproj" />
    <Binary Include="..\src\Lyrbuild\Lyrbuild.csproj" />
    <Binary Include="..\src\Lyrpack\Lyrpack.csproj" />
    <Binary Include="..\src\Lyrfmt\Lyrfmt.csproj" />

    <!--
      The language server. Not a tool of the driver — an editor starts it directly and it owns its
      stdio for the whole session — but it ships in the same directory, which is what lets the
      editor extension find it beside the driver it was already told about.
    -->
    <Binary Include="..\src\Lyrls\Lyrls.csproj" />

    <!--
      Not an executable but the library a HOST builds against. It belongs here because no binary
      references it, so without this entry it lands in no shipping directory at all.
    -->
    <Binary Include="..\src\Lyric.Embedding\Lyric.Embedding.csproj" />
  </ItemGroup>

  <!--
    A separate call BEFORE the publish rather than 'Targets="Restore;Publish"': MSBuild evaluates a
    project once, and the files restore produces (project.assets.json) have to exist at that point.
    In a single pass the publish would come too early.

    Without this step the command only runs where a build has happened before; on a fresh clone it
    fails with "Assets file ... not found".
  -->
  <Target Name="Restore">
    <MSBuild Projects="@(Binary)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="$(PublishProperties)" />

    <!-- Restored without the RID: its RuntimeIdentifiers list already writes every RID target
         into the assets file, and a restore under a single RuntimeIdentifier would not. -->
    <MSBuild Projects="..\src\Lyrstub\Lyrstub.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <!--
    Trimming and the shared directory above cannot both hold.

    It looks like a free win — measured on win-x64 it takes the archive from 79 MB to 21 MB and the
    .NET assemblies from 168 to 17 — and it produces a toolchain that does not start. Each app is
    trimmed against ITS OWN reachable set and writes its own copy of the assemblies they SHARE, so
    the last publish wins: 'lyrcore.dll' came out at 56320 bytes instead of 84480, without
    'Lyric.Core.CliDiagnostics', and three of the four binaries died with a TypeLoadException on
    startup. Only 'lyrrepl' worked, because it is published last. 'TrimMode=partial' behaves the
    same, and ILLink refuses 'lyrembed' outright — a library has no entry point to root from, so the
    host library would be missing from the archive entirely.

    Stopped here rather than left as a comment: a property on the command line overrides anything
    this file sets, and the damage shows on a user's machine rather than in the build. A trimmed
    build would need one directory per binary, which multiplies the runtime by four.
  -->
  <Target Name="RejectTrimming" BeforeTargets="Publish">
    <Error Condition="'$(PublishTrimmed)' == 'true'"
           Text="PublishTrimmed cannot be used here: the binaries share one directory, each is trimmed against its own reachable set, and the last publish overwrites the shared assemblies. Three of the four binaries then fail at startup. See the comment above this target." />
  </Target>

  <Target Name="Publish" DependsOnTargets="Clean;Restore">
    <MSBuild Projects="@(Binary)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="$(PublishProperties);PublishDir=$(PublishRoot)\" />

    <!--
      Into its own subdirectory, as ONE file. Single-file is what makes a pack a single
      artifact; the own directory is what keeps it out of the shared-assembly overlap the
      comment at the top describes — which is also why trimming stays rejected wholesale
      rather than made an exception here: one rule, no special case to explain.
    -->
    <MSBuild Projects="..\src\Lyrstub\Lyrstub.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(StubRid);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(PublishRoot)\stubs\$(StubRid)\" />

    <ItemGroup>
      <Published Include="$(PublishRoot)\**\*" />
    </ItemGroup>

    <Message Importance="high" Text=" " />
    <Message Importance="high" Text="  $(PublishRoot)" />
    <Message Importance="high" Text="    %(Published.Filename)%(Published.Extension)"
             Condition="'%(Published.RecursiveDir)' == ''" />
    <Message Importance="high" Text="    %(Published.RecursiveDir)%(Published.Filename)%(Published.Extension)"
             Condition="'%(Published.RecursiveDir)' != ''" />
    <Message Importance="high" Text=" " />
  </Target>

  <Target Name="Clean">
    <!--
      Emptied first rather than written over. A publish directory that grows across restructurings
      collects DLLs under old names, and whoever ships the folder ships them with it.
    -->
    <RemoveDir Directories="$(PublishRoot)" />
  </Target>

</Project>
