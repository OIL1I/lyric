import std.test { Test, assertEq, assertTrue };
import std.string {
    trim,
    split,
    join,
    indexOf,
    lastIndexOf,
    replace,
    count,
    parseInt,
    padStart,
    isBlank,
    StringBuilder,
};

@Test
pub fn trim_takes_both_ends(): void {
    assertEq(trim("  ab  "), "ab");
    assertEq(trim(""), "");
}

@Test
pub fn split_and_join_are_inverse(): void {
    let parts = split("a,b,c", ",");
    assertEq(parts.length, 3);
    assertEq(join(parts, ","), "a,b,c");
}

@Test
pub fn indexOf_answers_minus_one_for_absence(): void {
    assertEq(indexOf("abc", "z"), -1);
    assertEq(indexOf("abcabc", "bc"), 1);
    assertEq(lastIndexOf("abcabc", "bc"), 4);
}

@Test
pub fn replace_takes_every_occurrence_without_overlap(): void {
    assertEq(replace("aaa", "aa", "b"), "ba");
    assertEq(count("aaa", "aa"), 1);
}

@Test
pub fn parseInt_handles_signs_and_refuses_junk(): void {
    assertEq(parseInt("-42")!, -42);
    assertEq(parseInt("+7")!, 7);
    assertTrue(parseInt("") == null, "empty is not a number");
    assertTrue(parseInt("-") == null, "a sign alone is not a number");
    assertTrue(parseInt("4x2") == null, "junk is not a number");
}

@Test
pub fn padStart_never_truncates(): void {
    assertEq(padStart("7", 3, '0'), "007");
    assertEq(padStart("1234", 3, '0'), "1234");
}

@Test
pub fn isBlank_sees_whitespace_only(): void {
    assertTrue(isBlank("  \t"), "whitespace is blank");
    assertTrue(!isBlank(" x "), "content is not blank");
}

@Test
pub fn a_builder_joins_its_pieces(): void {
    let sb = StringBuilder.new();
    sb.append("a");
    sb.appendChar('b');
    sb.appendLine("c");
    assertEq(sb.build(), "abc\n");
}

// The balanced concatenation (v1.14): many pieces, one linear-ish build — and building twice
// must yield the same string, because `build` reads and never consumes.
@Test
pub fn a_builder_with_many_pieces_builds_repeatably(): void {
    let b = StringBuilder.new();
    var i = 0;
    while (i < 100) {
        b.append("x");
        i = i + 1;
    }
    let first = b.build();
    assertEq(first, b.build());
    assertTrue(count(first, "x") == 100, "expected 100 pieces in the built string");
}

@Test
pub fn join_weaves_the_separator_between_all_parts(): void {
    assertEq(join(["a", "b", "c", "d", "e"], "-"), "a-b-c-d-e");
    assertEq(join([], "-"), "");
    assertEq(join(["solo"], "-"), "solo");
}

@Test
pub fn replace_leaves_a_string_without_matches_untouched(): void {
    assertEq(replace("abc", "zz", "y"), "abc");
    assertEq(replace("start middle end", "middle", ""), "start  end");
}
