<Project>

  <!--
    Was fuer jedes Projekt gilt. Vorher stand dieser Block vierzehnmal wortgleich in den einzelnen
    .csproj, und beim Anlegen des fuenfzehnten Projekts wurde er wieder abgeschrieben — dieselbe
    Duplikation, die CONTRIBUTING.md im Code verbietet, nur im Build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      Reproduzierbare Builds. ADR-013 verlangt byte-identische .lyrbc-Ausgabe fuer dieselbe Eingabe;
      dass auch die Binaries, die sie erzeugen, reproduzierbar sind, ist die logische Fortsetzung.
    -->
    <Deterministic>true</Deterministic>

    <!--
      Keine Locale im Spiel. Der Compiler formatiert Zahlen in Diagnosen und in den Phasenzeiten
      des ausfuehrlichen Modus; auf einem deutschen System kam dort schon einmal ein Dezimalkomma
      heraus. CultureInfo.InvariantCulture an den Aufrufstellen bleibt richtig — dies hier ist der
      Guertel dazu.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Lyric</Product>
    <Company>Lyric</Company>
    <Copyright>Olivier</Copyright>

    <!--
      Dieselbe Zahl wie Lyric.Core.ToolchainVersion.Value — sie steht hier ein zweites Mal, weil
      MSBuild keine C#-Konstante lesen kann und die Datei-Eigenschaften der Binaries sie brauchen.
      Zwei Wahrheiten sind eine zu viel, deshalb vergleicht Lyric.Tests.Core sie gegen das
      erzeugte AssemblyInformationalVersion-Attribut: die Doppelung bleibt, aber sie kann nicht
      mehr unbemerkt auseinanderlaufen.
    -->
    <Version>0.9.0</Version>
  </PropertyGroup>

  <!--
    Debug-Symbole gehoeren in den Debug-Build und in nichts sonst. 'embedded' statt einer .pdb
    daneben: waehrend der Entwicklung will man Stacktraces mit Zeilennummern, aber keine zweite
    Datei je Assembly. Im Release faellt beides weg — was ausgeliefert wird, soll nur das
    Programm sein.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
