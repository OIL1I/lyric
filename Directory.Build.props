<Project>

  <!-- What applies to every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Reproducible builds: the same input produces byte-identical binaries. -->
    <Deterministic>true</Deterministic>

    <!--
      No locale in play. The compiler formats numbers in diagnostics and in the phase timings of
      the verbose mode; on a German system that produced a decimal comma. CultureInfo.InvariantCulture
      at the call sites stays correct; this is the belt around it.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Lyric</Product>
    <Company>Lyric</Company>
    <Copyright>Olivier</Copyright>

    <!--
      The same number as Lyric.Core.ToolchainVersion.Value. It stands here a second time because
      MSBuild cannot read a C# constant and the file properties of the binaries need it.
      Lyric.Tests.Core compares the two against the generated AssemblyInformationalVersion
      attribute, so they cannot drift apart unnoticed.
    -->
    <Version>2.2.0</Version>
  </PropertyGroup>

  <!--
    Debug symbols belong in the Debug build and nowhere else. 'embedded' rather than a .pdb next to
    the assembly: stack traces carry line numbers without a second file per assembly. In Release
    both are dropped.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
