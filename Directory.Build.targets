<Project>

  <!--
    Evaluated AFTER the .csproj: the rules here need to know whether a project is an application.
    In Directory.Build.props '$(OutputType)' would still be empty.
  -->

  <PropertyGroup Condition="'$(OutputType)' == 'Exe' and '$(Configuration)' == 'Release' and '$(IsTestProject)' != 'true'">
    <!--
      No .deps.json in Release. It describes the dependency graph for the host; without it the host
      loads whatever lies next to the application instead. That is the wanted behaviour here: the
      libraries beside the binaries are all ours, and no NuGet package is on the shipping path.

      The .runtimeconfig.json stays. Without it the host does not know which framework version to
      load and the application does not start.
    -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

</Project>
