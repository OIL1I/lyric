<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyric</AssemblyName>
    <RootNamespace>Lyric.Cli</RootNamespace>
    <Description>Der Treiber: compile, run, disasm — und die Wahl der Runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Der Treiber (ADR-017): darf beide Seiten kennen, weil er beide fahren koennen muss. Er
      enthaelt trotzdem keine eigene Pipeline — SourceCompiler und VmHost sind dieselben
      Einstiege, die auch lyrc und lyrvm benutzen. Die Stdlib kommt als Content ueber
      Lyric.Frontend mit.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
    <ProjectReference Include="..\Lyric.Vm\Lyric.Vm.csproj" />
  </ItemGroup>

</Project>
