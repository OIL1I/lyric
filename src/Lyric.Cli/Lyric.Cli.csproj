<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyric</AssemblyName>
    <RootNamespace>Lyric.Cli</RootNamespace>
    <Description>The entry point of the tool suite: selects tools and passes through.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ONE reference. This driver compiles nothing and executes nothing, it starts tools. No lyrfe,
      no lyrrt — it needs the exit codes and the diagnostic codes only, so an error of ITS own does
      not look like an error of a tool.

      An edge from here to lyrfe or lyrrt would make the driver a second compiler;
      tests/Lyric.Tests.Cli checks that mechanically.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />

    <!--
      The tools are BUILT but neither referenced nor copied from here: they lie in the same output
      directory, because that is where the driver looks for them.
    -->
    <ProjectReference Include="..\Lyrc\Lyrc.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Lyrvm\Lyrvm.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Lyrrepl\Lyrrepl.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Puts the tools next to the driver COMPLETELY, not only their apphost. A framework-dependent
    'lyrc.exe' is a launcher expecting 'lyrc.dll' beside it; without it, it starts with "The
    application to execute does not exist".

    The output directory during development then looks like the publish directory. The driver looks
    for its tools beside itself, and "beside itself" has to mean the same in both cases.
  -->
  <Target Name="CopyToolsNextToDriver" AfterTargets="Build">
    <MSBuild Projects="..\Lyrc\Lyrc.csproj;..\Lyrvm\Lyrvm.csproj;..\Lyrrepl\Lyrrepl.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ToolAssembly" />
    </MSBuild>

    <ItemGroup>
      <!-- The stdlib included: it belongs next to the compiler, and "next to" is a directory here. -->
      <ToolFile Include="%(ToolAssembly.RootDir)%(ToolAssembly.Directory)**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(ToolFile)"
          DestinationFiles="@(ToolFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
