<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyrvm</AssemblyName>
    <RootNamespace>Lyric.Cli.Runtime</RootNamespace>
    <Description>The bundled runtime and reference implementation of the runner contract.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Two references, and that is the point: no lexer, no parser, no resolver, no sema, no IR, no
      bytecode writer. tests/Lyric.Tests.Cli checks mechanically that lyrfe.dll never lands next to
      the exe.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Vm\Lyric.Vm.csproj" />
  </ItemGroup>

</Project>
