<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lyrc</AssemblyName>
    <RootNamespace>Lyric.Cli.Compiler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Der Compiler (ADR-017). Keine Kante nach Lyric.Vm: 'lyrc' fuehrt nichts aus.
      Lyric.Bytecode kommt fuer den Disassembler-freien Teil ueber Lyric.Compiler mit.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Lexing\Lyric.Lexing.csproj" />
    <ProjectReference Include="..\Lyric.AST\Lyric.AST.csproj" />
    <ProjectReference Include="..\Lyric.Parsing\Lyric.Parsing.csproj" />
    <ProjectReference Include="..\Lyric.Ir\Lyric.Ir.csproj" />
    <ProjectReference Include="..\Lyric.Compiler\Lyric.Compiler.csproj" />
  </ItemGroup>

</Project>
