<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyrc</AssemblyName>
    <RootNamespace>Lyric.Cli.Compiler</RootNamespace>
    <Description>Der Lyric-Compiler: Quelltext zu .lyrbc.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Der Compiler (ADR-017). Zwei Referenzen, und keine davon ist die Runtime: 'lyrc' fuehrt
      nichts aus. tests/Lyric.Tests.Cli prueft, dass lyrrt.dll hier nie auftaucht.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
  </ItemGroup>

</Project>
