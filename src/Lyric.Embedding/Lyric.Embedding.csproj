<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrembed</AssemblyName>
    <RootNamespace>Lyric.Embedding</RootNamespace>
    <Description>The embedding API: a .NET host loads Lyric scripts and decides what they may do.</Description>

    <!--
      As for the binaries in Directory.Build.targets, whose rule hangs on OutputType == 'Exe': this
      assembly ships as a PROJECT and therefore produces a .deps.json of its own. For a library it
      is meaningless at run time — the consuming host produces its own — and the README promises
      that none lies in the shipping directory.
    -->
    <GenerateDependencyFile Condition="'$(Configuration)' == 'Release'">false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BOTH libraries, deliberately. An embedding API compiles (lyrfe) AND executes (lyrrt); without
      both there would be no 'Compile' beside 'Run'. The same pair as 'lyrrepl'.

      That does not soften the separation: the edge separates the LIBRARIES, it does not forbid
      using both. What it forbids is an edge from lyrrt to lyrfe — which is why this class stands
      here and not in Lyric.Vm, where it would break the architecture test holding that 'lyrvm.exe'
      ships neither lyrfe.dll nor stdlib/.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
    <ProjectReference Include="..\Lyric.Vm\Lyric.Vm.csproj" />
  </ItemGroup>

</Project>
