<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrembed</AssemblyName>
    <RootNamespace>Lyric.Embedding</RootNamespace>
    <Description>Die Embedding-API: ein .NET-Host laedt Lyric-Skripte und entscheidet, was sie duerfen.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BEIDE Bibliotheken — und das ist Absicht, nicht Nachlaessigkeit. Eine Embedding-API
      uebersetzt (lyrfe) UND fuehrt aus (lyrrt); ohne beides gaebe es kein 'Compile' neben 'Run'.
      Dasselbe Paar wie bei 'lyrrepl', und aus demselben Grund (ADR-021).

      Das widerspricht ADR-017 nicht: die Kante trennt die BIBLIOTHEKEN, sie verbietet nicht,
      beide zu benutzen. Was sie verbietet, ist eine Kante von lyrrt nach lyrfe — und genau
      deshalb steht diese Klasse hier und nicht in Lyric.Vm, wie ROADMAP.md §Zentrale Komponenten
      es bis 2026-08-11 behauptet hat. Dort haette sie den Architektur-Test umgebracht, der
      festhaelt, dass 'lyrvm.exe' weder lyrfe.dll noch stdlib/ ausliefert.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
    <ProjectReference Include="..\Lyric.Vm\Lyric.Vm.csproj" />
  </ItemGroup>

</Project>
