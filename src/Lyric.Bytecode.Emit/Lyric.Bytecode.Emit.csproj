<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Die Schreibseite des Formats (ADR-017). Sie darf die IR kennen; die Leseseite darf es nicht,
      sonst zoege eine Runtime den gesamten Compiler mit. Deshalb liegt genau hier die Kante nach
      Lyric.Ir — und nur hier.

      Der Namespace bleibt 'Lyric.Bytecode': das Format ist ein Konzept (docs/Bytecode.md ist ein
      Dokument), die Assembly-Grenze trennt Abhaengigkeiten, nicht Begriffe.
    -->
    <ProjectReference Include="..\Lyric.Bytecode\Lyric.Bytecode.csproj" />
    <ProjectReference Include="..\Lyric.Ir\Lyric.Ir.csproj" />
  </ItemGroup>

</Project>
