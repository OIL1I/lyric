<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrrt</AssemblyName>
    <RootNamespace>Lyric.Vm</RootNamespace>
    <Description>Die mitgelieferte Referenz-Runtime: Interpreter, Werte, Dispatch, Host-API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Genau eine Kante — und das ist der Punkt (ADR-017). Die Runtime kennt das Format nur ueber
      die Leseseite in lyrcore; sie kennt weder Lexer noch Parser noch Sema noch IR noch den
      Bytecode-Writer. Kommt hier je eine Kante nach Lyric.Frontend dazu, ist ADR-013 ("jemand
      schreibt eine zweite Runtime allein aus der Spec") nur noch eine Behauptung.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
  </ItemGroup>

</Project>
