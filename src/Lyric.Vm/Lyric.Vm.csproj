<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrrt</AssemblyName>
    <RootNamespace>Lyric.Vm</RootNamespace>
    <Description>The bundled reference runtime: interpreter, values, dispatch, host API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exactly one edge. The runtime knows the format only through the reading side in lyrcore; it
      knows neither lexer nor parser nor sema nor IR nor the bytecode writer. An edge from here to
      Lyric.Frontend would make "a second runtime is writable from the specification alone" a claim
      rather than a fact.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
  </ItemGroup>

</Project>
