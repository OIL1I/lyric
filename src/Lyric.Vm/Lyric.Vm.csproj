<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Die Runtime kennt das Format nur lesend (ADR-017). Keine Kante nach Lyric.Bytecode.Emit,
      Lyric.Ir, Lyric.Sema oder Lyric.Parsing — 'lyrvm' waere sonst ein Compiler mit
      Interpreter-Anhang statt einer zweiten, unabhaengigen Implementierung der Spec.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Bytecode\Lyric.Bytecode.csproj" />
  </ItemGroup>

</Project>
