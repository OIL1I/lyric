<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Die Pipeline Quelle -> IR -> Bytes als Bibliothek (ADR-017). 'lyrc' und 'lyric' rufen beide
      hier hinein; keiner der beiden haelt eine eigene Kopie des Vorspanns. Diese Datei ist auch
      der spaetere Unterbau von M10s LangVm.Compile(string source).
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Lexing\Lyric.Lexing.csproj" />
    <ProjectReference Include="..\Lyric.AST\Lyric.AST.csproj" />
    <ProjectReference Include="..\Lyric.Parsing\Lyric.Parsing.csproj" />
    <ProjectReference Include="..\Lyric.Resolver\Lyric.Resolver.csproj" />
    <ProjectReference Include="..\Lyric.Sema\Lyric.Sema.csproj" />
    <ProjectReference Include="..\Lyric.Ir\Lyric.Ir.csproj" />
    <ProjectReference Include="..\Lyric.Bytecode\Lyric.Bytecode.csproj" />
    <ProjectReference Include="..\Lyric.Bytecode.Emit\Lyric.Bytecode.Emit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Stdlib ist Quelltext und muss neben dem Binary liegen; ueberlebt auch dotnet publish. -->
    <Content Include="..\..\stdlib\**\*.lyr" Link="stdlib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
