<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyrrepl</AssemblyName>
    <RootNamespace>Lyric.Cli.Repl</RootNamespace>
    <Description>The interactive loop: compiles and executes in the same process.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The one binary with BOTH sides. A REPL compiles AND executes, and the state between the two
      has to stay alive; 'lyric run' solves that with two subprocesses, which is not possible here.

      The edge separates the LIBRARIES, it does not forbid using both. The architecture test in
      tests/Lyric.Tests.Cli holds the separation for lyrc and lyrvm and this exception for lyrrepl.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
    <ProjectReference Include="..\Lyric.Vm\Lyric.Vm.csproj" />
  </ItemGroup>

</Project>
