<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrfe</AssemblyName>
    <RootNamespace>Lyric</RootNamespace>
    <Description>Everything between source and bytes: lexer, parser, resolver, sema, IR, emit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      One edge, the same one the runtime has: the format is read (opcodes, type tags, verification
      after writing), not executed. NO edge to Lyric.Vm — 'lyrc' executes nothing.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stdlib is source and has to lie next to the binary; this survives dotnet publish. -->
    <Content Include="..\..\stdlib\**\*.lyr" Link="stdlib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Eight areas in one assembly: Lexing, AST, Parsing, Resolver, Sema, Ir, Emit, Compiler.

    What that costs: the fine edges INSIDE the frontend are convention rather than a compiler error.
    The parser could call the sema, the sema the IR. What remains enforced is the large edge: a
    runtime sees none of this, and a compiler gets no interpreter. That one is an assembly boundary
    and is checked mechanically.
  -->

</Project>
