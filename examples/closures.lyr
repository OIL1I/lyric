// Closures.
//
// A closure captures the VARIABLE, not its value. 'counter' returns a function that keeps counting
// its 'n' up although the creating call has long returned, and two closures over the same 'n' see
// the same one.
import std.io.console;

// A captured 'let' is copied: it never changes, so the difference is not observable and the copy
// saves the cell.
fn scaler(factor: int): fn(int) -> int {
    return (x: int) => x * factor;
}

// A captured 'var' is shared. It lives in a cell on the heap rather than in the frame.
fn counter(): fn() -> int {
    var n = 0;
    return (): int => { n += 1; return n; };
}

// A closure as a parameter: the case function types exist for.
fn applyTwice(f: fn(int) -> int, v: int): int {
    return f(f(v));
}

fn main(): int {
    let triple = scaler(3);
    console.println(f"triple(7) = {triple(7)}");

    let next = counter();
    next();
    next();
    console.println(f"nach drei Aufrufen: {next()}");

    console.println(f"applyTwice: {applyTwice(triple, 2)}");

    // Two closures, one variable.
    var total = 0;
    let add = (x: int) => { total = total + x; };
    let read = (): int => total;
    add(10);
    add(30);
    console.println(f"geteiltes total: {read()}");

    // 21 + 4 + 18 + 40 = 83. The 4 is the point: 'next()' CONTINUES counting here rather than
    // yielding the 3 from above again. By value it would be a 1.
    return triple(7) + next() + applyTwice(triple, 2) + read();
}
