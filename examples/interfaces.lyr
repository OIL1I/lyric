// Interfaces and vtable dispatch.
//
// 'hit' knows only 'Damageable' and not whether a Player or a Wall stands in front of it. Which
// 'takeDamage' runs is decided at run time; this is the only dynamic dispatch in the language.
import std.io.console;

pub interface Damageable {
    mut fn takeDamage(amount: int);
    fn getHp(): int;

    // A default method: whoever does not override it inherits it. The 'this.getHp()' inside is
    // itself a virtual call, because in a default method 'this' has the interface type.
    fn isAlive(): bool {
        return this.getHp() > 0;
    }
}

pub class Player :: [Damageable] {
    hp: int,

    static fn new(hp: int): Player {
        return Player { hp = hp };
    }

    mut fn takeDamage(amount: int) {
        this.hp -= amount;
        if (this.hp < 0) {
            this.hp = 0;
        }
    }

    fn getHp(): int {
        return this.hp;
    }
}

pub class Wall :: [Damageable] {
    hp: int,

    static fn new(hp: int): Wall {
        return Wall { hp = hp };
    }

    // A Wall absorbs half of it.
    mut fn takeDamage(amount: int) {
        this.hp -= amount / 2;
        if (this.hp < 0) {
            this.hp = 0;
        }
    }

    fn getHp(): int {
        return this.hp;
    }

    // Overrides the default: a Wall counts as destroyed only below 10 hp.
    fn isAlive(): bool {
        return this.hp > 10;
    }
}

// Knows the contract only, never the class.
fn hit(target: Damageable, amount: int): int {
    target.takeDamage(amount);
    return target.getHp();
}

fn describe(target: Damageable): string {
    if (target.isAlive()) {
        return "alive";
    }
    return "down";
}

fn main(): int {
    let player = Player.new(100);
    let wall = Wall.new(100);

    // The same call, two implementations: 100-40 = 60 and 100-20 = 80.
    let playerHp = hit(player, 40);
    let wallHp = hit(wall, 40);

    console.println(f"player: {playerHp}, wall: {wallHp}");

    // The default method against the override: a Player with 5 hp lives, a Wall with 5 does not.
    let weak = Player.new(5);
    let rubble = Wall.new(5);
    console.println(f"weak player: {describe(weak)}, rubble: {describe(rubble)}");

    return playerHp + wallHp;
}
