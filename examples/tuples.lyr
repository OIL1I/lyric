// Tuples: several values in one, without declaring a type for it.
//
// The only way to the elements is destructuring; an access like 't.0' does not exist. A tuple is a
// multiple return, and that is taken apart immediately.
import std.io.console;

// The case tuples exist for: returning two values without inventing a type for them.
fn divmod(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

// Nesting works too: the pattern follows the shape of the value.
fn corners(): ((int, int), (int, int)) {
    return ((0, 0), (10, 5));
}

fn main(): int {
    let (q, r) = divmod(17, 5);
    console.println(f"17 / 5 = {q} Rest {r}");

    // '_' binds nothing: the field is not even read.
    let (_, rest) = divmod(9, 4);
    console.println(f"nur der Rest: {rest}");

    let ((x0, y0), (x1, y1)) = corners();
    console.println(f"von ({x0},{y0}) bis ({x1},{y1})");

    // A 'match' decomposes the same way: the same pattern, the same mechanism.
    let point = (3, 4);
    let sum = match (point) { (a, b) => a + b };
    console.println(f"3 + 4 = {sum}");

    // 3 + 1 + 15 + 7 = 26
    return q + rest + (x1 + y1) + sum;
}
