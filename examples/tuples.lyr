// Tupel (Sprache.md §4): mehrere Werte in einem, ohne dafuer einen Typ zu deklarieren.
//
// Der einzige Weg an die Elemente ist Destructuring — einen Zugriff wie 't.0' gibt es
// absichtlich nicht. Ein Tupel ist eine Mehrfachrueckgabe, und die will man sofort
// auseinandernehmen; zwei Wege zur selben Sache waeren zwei Mechanismen.
import std.io.console;

// Der Fall, fuer den es Tupel gibt: zwei Werte zurueckgeben, ohne einen Typ dafuer zu erfinden.
fn divmod(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

// Verschachtelt geht auch — das Muster folgt der Form des Wertes.
fn corners(): ((int, int), (int, int)) {
    return ((0, 0), (10, 5));
}

fn main(): int {
    let (q, r) = divmod(17, 5);
    console.println(f"17 / 5 = {q} Rest {r}");

    // '_' bindet nichts: das Feld wird gar nicht erst gelesen.
    let (_, rest) = divmod(9, 4);
    console.println(f"nur der Rest: {rest}");

    let ((x0, y0), (x1, y1)) = corners();
    console.println(f"von ({x0},{y0}) bis ({x1},{y1})");

    // Ein 'match' zerlegt genauso — dasselbe Muster, derselbe Mechanismus.
    let point = (3, 4);
    let sum = match (point) { (a, b) => a + b };
    console.println(f"3 + 4 = {sum}");

    // 3 + 1 + 15 + 7 = 26
    return q + rest + (x1 + y1) + sum;
}
