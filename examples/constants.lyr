// Gate-Programm fuer M7/P5c — Konstanten als globale Slots.
//
// Der Kern: ein Modul-'let' und ein 'static let' sind DERSELBE Mechanismus. Beide werden vor dem
// Programmstart einmal von einer synthetischen '<globals>'-Funktion gefuellt; der Unterschied ist
// nur, wo der Name sichtbar ist. Deshalb darf ein Initialisierer auch alles, was ein Rumpf darf —
// rechnen, rufen, Objekte anlegen.
import std.io.console;

let VERSION = "1.0";
let BANNER = "lyric " + VERSION;

// Reihenfolge ist Deklarationsreihenfolge: BASE liest LEVELS, weil LEVELS darueber steht.
// Andersherum waere es LYR-SEM0057, und zwar zu Recht — dort stuende ein Wert, den niemand
// geschrieben hat.
let LEVELS = 4;
let BASE = LEVELS * 10;

pub struct Vector2 {
    x: int,
    y: int,

    // Eine typgebundene Konstante, die ein Objekt ist. Genau dieser Fall entscheidet, warum die
    // Globals-Sektion eine Init-FUNKTION referenziert und keine Werte enthaelt: 'Vector2 { … }'
    // ist ein Ausdruck, kein Literal.
    static let ORIGIN: Vector2 = Vector2 { x = 0, y = 0 };

    fn sum(): int {
        return this.x + this.y;
    }
}

pub class Enemy {
    name: string,
    hp: int,

    static let BASE_HP: int = 10;

    static fn new(level: int): Enemy {
        return Enemy { name = "goblin", hp = Enemy.BASE_HP * level };
    }
}

// Aus einem Rumpf ist jede Konstante lesbar, egal wo sie steht — hier laeuft die Init-Phase
// laengst nicht mehr. TAIL steht erst ganz unten.
fn describe(): string {
    return BANNER + TAIL;
}

fn main(): int {
    console.println(describe());
    console.println(f"origin sum: {Vector2.ORIGIN.sum()}");

    var total = 0;
    var level = 1;
    while (level <= LEVELS) {
        let e = Enemy.new(level);
        console.println(f"{e.name} lvl {level}: {e.hp} hp");
        total = total + e.hp;
        level = level + 1;
    }

    console.println(f"total: {total}");
    console.println(f"base: {BASE}");

    // 10 + 20 + 30 + 40 = 100, plus BASE 40 => 140.
    return total + BASE;
}

let TAIL = " (constants)";
