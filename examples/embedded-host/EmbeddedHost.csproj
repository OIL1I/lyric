<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The example host: a consumer of the library, not part of it.

    It stands in Lyric.slnx all the same. 'dotnet test' on the solution builds the projects of the
    solution, and a ProjectReference from outside with ReferenceOutputAssembly=false does not drag
    it along — without the entry the tests pass locally and fail on a cold checkout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EmbeddedHost</RootNamespace>
    <AssemblyName>embedded-host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lyric.Embedding\Lyric.Embedding.csproj" />
  </ItemGroup>

  <!--
    The stdlib lies next to the host as SOURCE: a '.lyrbc' carries its imports symbolically and
    they are resolved while compiling. A host that compiles scripts therefore needs it just as
    'lyric' and 'lyrc' do.
  -->
  <ItemGroup>
    <Content Include="..\..\stdlib\**\*.lyr"
             Link="stdlib\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
