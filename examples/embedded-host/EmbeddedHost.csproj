<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Der Beispiel-Host aus M10 — ein Konsument der Bibliothek, kein Teil von ihr.

    Er steht trotzdem in Lyric.slnx, und das war eine Korrektur: hier stand erst "NICHT in der
    Solution, gebaut wird er vom Test". Das ging beim direkten Aufruf und scheiterte KALT —
    'dotnet test' auf der Solution baut die Projekte der Solution, und eine ProjectReference von
    aussen mit ReferenceOutputAssembly=false zieht ihn dabei nicht mit. Vier gruene Tests lokal,
    vier rote in CI.

    Dieselbe Fehlerklasse wie 'build/publish.proj', das in keinem Clone lag: etwas funktioniert
    auf dem Rechner, auf dem es entstanden ist, und der kanonische Pfad kennt es nicht.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EmbeddedHost</RootNamespace>
    <AssemblyName>embedded-host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lyric.Embedding\Lyric.Embedding.csproj" />
  </ItemGroup>

  <!--
    Die Stdlib liegt als QUELLTEXT neben dem Host — ein '.lyrbc' traegt seine Importe symbolisch
    (ADR-012), aufgeloest werden sie beim Uebersetzen. Ein Host, der Skripte uebersetzt, braucht
    sie deshalb genauso wie 'lyric' und 'lyrc'.
  -->
  <ItemGroup>
    <Content Include="..\..\stdlib\**\*.lyr"
             Link="stdlib\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
