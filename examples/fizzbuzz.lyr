// fizzbuzz.lyr — Komplexität: einfach
// Zeigt: for-in mit inklusivem Range, if/else-if-Ketten, Modulo,
// String-Interpolation.

import std.io.console { println };

fn main(): int {
    for (n in 1..=100) {
        if (n % 15 == 0) {
            println("FizzBuzz");
        } else if (n % 3 == 0) {
            println("Fizz");
        } else if (n % 5 == 0) {
            println("Buzz");
        } else {
            println(f"{n}");
        }
    }
    return 0;
}
