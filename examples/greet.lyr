// Zeigt die zweite Einstiegsform aus Sprache.md §11: 'fn main(args: string[])'.
//
// Alles nach dem ersten '--' gehoert dem Programm (Bytecode.md §9):
//
//     lyric run examples/greet.lyr -- Welt Lyric
//
// Ein parameterloses 'main' ignoriert uebergebene Argumente — das ist kein Fehler, sondern
// dieselbe Freiheit, die jede Shell hat.
import std.io.console;

fn main(args: string[]): int {
    if (args.length == 0) {
        console.println("hallo, niemand");
        return 0;
    }

    for (name in args) {
        console.println("hallo, " + name);
    }

    return args.length;
}
