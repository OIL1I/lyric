// The second entry form: 'fn main(args: string[])'.
//
// Everything after the first '--' belongs to the program:
//
//     lyric run examples/greet.lyr -- World Lyric
//
// A parameterless 'main' ignores passed arguments rather than failing.
import std.io.console;

fn main(args: string[]): int {
    if (args.length == 0) {
        console.println("hallo, niemand");
        return 0;
    }

    for (name in args) {
        console.println("hallo, " + name);
    }

    return args.length;
}
