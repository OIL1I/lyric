// optionals.lyr — Komplexität: einfach
// Zeigt: ?T, null, ??, !, Flow-Narrowing.
//
// Gate-Programm für M7/P2b. `?T` bedeutet „vielleicht ein Wert" — und die Sprache lässt dich nicht
// vergessen, den Fall zu behandeln: an einen `int` kommst du nur über `??`, `!` oder eine
// Null-Prüfung, die den Typ einengt.

import std.io.console { println };

class Account {
    owner: string,
    balance: int
}

// Kein Treffer ist ein normaler Ausgang, kein Fehler — deshalb `?Account` und nicht `throws`.
fn findAccount(accounts: Account[], owner: string): ?Account {
    var i = 0;
    while (i < accounts.length) {
        if (accounts[i].owner == owner) {
            return accounts[i];
        }
        i += 1;
    }
    return null;
}

fn balanceOf(accounts: Account[], owner: string): int {
    let found = findAccount(accounts, owner);

    // Flow-Narrowing (§7): im then-Zweig hat `found` den Typ `Account`, nicht `?Account`.
    // Der Zugriff auf `.balance` braucht deshalb kein `!`.
    if (found != null) {
        return found.balance;
    }
    return 0;
}

fn main(): int {
    let accounts = [
        Account { owner = "Olivier", balance = 120 },
        Account { owner = "Mara", balance = 80 }
    ];

    let mara = balanceOf(accounts, "Mara");
    let niemand = balanceOf(accounts, "Kim");

    // `??` wertet seine rechte Seite nur aus, wenn links nichts steht.
    let fallback = findAccount(accounts, "Kim") ?? accounts[0];

    println(f"Mara: {mara}, unbekannt: {niemand}, Ersatz: {fallback.owner}");
    return mara + niemand + fallback.balance;
}
